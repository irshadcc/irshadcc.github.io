---
import Layout from "../layouts/Layout.astro";
import { getPosts } from "../posts";

const posts = await getPosts();
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// Group posts by year, newest year first (posts are already sorted).
const years = new Map<number, typeof posts>();
for (const post of posts) {
	const year = post.data.date.getUTCFullYear();
	years.set(year, [...(years.get(year) ?? []), post]);
}

const shortDate = (date: Date) =>
	date.toLocaleDateString("en-US", { month: "short", day: "2-digit", timeZone: "UTC" });
---

<Layout>
	{[...years].map(([year, yearPosts]) => (
		<section>
			<h2 class="year">{year}</h2>
			<ul class="post-list">
				{yearPosts.map((post) => (
					<li>
						<time datetime={post.data.date.toISOString()}>{shortDate(post.data.date)}</time>
						<div>
							<a href={`${base}/blog/${post.id}`}>{post.data.title}</a>
							<p>{post.data.description}</p>
						</div>
					</li>
				))}
			</ul>
		</section>
	))}
</Layout>
