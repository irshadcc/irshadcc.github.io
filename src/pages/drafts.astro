---
import PostTags from "../components/PostTags.astro";
import TagFilter from "../components/TagFilter.astro";
import Layout from "../layouts/Layout.astro";
import { getDraftPosts } from "../posts";

const posts = await getDraftPosts();
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const shortDate = (date: Date) =>
	date.toLocaleDateString("en-US", {
		month: "short",
		day: "2-digit",
		timeZone: "UTC",
	});
const tags = posts
	.flatMap((post) => post.data.tags)
	.filter((tag) => tag !== "Draft");
---

<Layout title="Drafts">
	<h1>Drafts</h1>
	<div class="post-browser">
		<TagFilter tags={tags} />
		<div class="post-browser-content">
			<ul class="post-list">
				{posts.map((post) => (
					<li data-tags={JSON.stringify(post.data.tags)}>
						<time datetime={post.data.date.toISOString()}>{shortDate(post.data.date)}</time>
						<div>
							<a href={`${base}/blog/${post.id}`}>{post.data.title}</a>
							<p>{post.data.description}</p>
							<PostTags tags={post.data.tags} />
						</div>
					</li>
				))}
			</ul>
		</div>
	</div>
</Layout>
