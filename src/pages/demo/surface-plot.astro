---
import Layout from "../../layouts/Layout.astro";
import SurfacePlot from "../../utils/charts/3DSurfacePlot.astro";

// Rosenbrock's banana function on a log scale, so the curved valley is visible.
const rosenbrock = (x: number, y: number) => Math.log10(1 + (1 - x) ** 2 + 100 * (y - x * x) ** 2);
---

<Layout title="SurfacePlot demo">
	<h1>SurfacePlot demo</h1>

	<h2>Sequential colour</h2>
	<SurfacePlot
		title="sin(r) / r"
		fn={(x: number, y: number) => {
			const r = Math.hypot(x, y);
			return r === 0 ? 1 : Math.sin(r) / r;
		}}
		x={[-10, 10]}
		y={[-10, 10]}
		samples={51}
		zLabel="sinc(r)"
	/>

	<h2>Diverging colour for a signed function</h2>
	<SurfacePlot
		fn={(x: number, y: number) => x * x - y * y}
		x={[-2, 2]}
		y={[-2, 2]}
		samples={31}
		diverging
		zLabel="x² − y²"
		yaw={-40}
		pitch={32}
	/>

	<h2>Loss landscape, no mesh</h2>
	<SurfacePlot
		fn={rosenbrock}
		x={[-2, 2]}
		y={[-1, 3]}
		samples={[61, 61]}
		mesh={false}
		xLabel="w₁"
		yLabel="w₂"
		zLabel="log₁₀ loss"
		height={380}
		yaw={20}
		pitch={40}
	/>

	<h2>Range sliders, restricted to the sampled grid</h2>
	<SurfacePlot
		fn={(x: number, y: number) => Math.sin(x) * Math.cos(y)}
		x={[-Math.PI, Math.PI]}
		y={[-Math.PI, Math.PI]}
		samples={61}
		diverging
		zLabel="sin(x)·cos(y)"
		rangeSliders
	/>

	<h2>Range sliders reaching past the sampled grid (re-sampled in the browser)</h2>
	<SurfacePlot
		fn={(x: number, y: number) => Math.exp(-(x * x + y * y) / 8) * Math.cos(x) * Math.cos(y)}
		x={[-4, 4]}
		y={[-4, 4]}
		samples={41}
		diverging
		zLabel="damped cos"
		rangeSliders
		restrictRange={false}
	/>

	<h2>Holes where f is undefined</h2>
	<SurfacePlot
		fn={(x: number, y: number) => Math.sqrt(4 - x * x - y * y)}
		x={[-2, 2]}
		y={[-2, 2]}
		samples={41}
		zLabel="√(4 − x² − y²)"
		height={340}
	/>
</Layout>
