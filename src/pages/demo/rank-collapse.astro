---
import Layout from "../../layouts/Layout.astro";
import RankCollapseSteps from "../../utils/neuralnetwork/RankCollapseSteps.astro";
---

<Layout title="RankCollapseSteps demo">
	<h1>RankCollapseSteps demo</h1>

	<h2>Mixing layer: keeps (1, 1), shrinks (1, −1) by 2/3</h2>
	<RankCollapseSteps
		matrix={[
			[5 / 6, 1 / 6],
			[1 / 6, 5 / 6],
		]}
		depths={[0, 1, 2, 4, 8, 16, 24, 32]}
		step={4}
		title="Twelve points, mixing layer, opening on depth 8"
	/>

	<h2>Stretch and squeeze with rotation, eight points, opening on step 3</h2>
	<RankCollapseSteps
		matrix={[
			[1.1, 0.3],
			[-0.1, 0.8],
		]}
		depths={[0, 1, 3, 6, 10, 20]}
		n={8}
		pair={[1, 5]}
		decimals={2}
		step={2}
		title="Non-symmetric layer: the outline grows, so the axes are scaled to the largest step"
	/>

	<h2>Rotation by 30°: orthogonal, no collapse</h2>
	<RankCollapseSteps
		matrix={[
			[Math.cos(Math.PI / 6), -Math.sin(Math.PI / 6)],
			[Math.sin(Math.PI / 6), Math.cos(Math.PI / 6)],
		]}
		depths={[0, 1, 2, 3]}
	/>

	<h2>Singular layer: rank 1 after one step</h2>
	<RankCollapseSteps
		matrix={[
			[1, 0],
			[0, 0],
		]}
		depths={[0, 1]}
		n={6}
		pair={[1, 2]}
	/>
</Layout>
