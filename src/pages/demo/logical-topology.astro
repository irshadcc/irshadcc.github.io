---
import Layout from "../../layouts/Layout.astro";
import { COLOR_SCALES, type ColorScaleName, colorScale } from "../../component/ProcessGroup/colorScales";
import LogicalDistributedTopology from "../../component/ProcessGroup/LogicalDistributedTopology.astro";

// Deterministic pseudo-random noise so the page is stable between builds.
let seed = 3;
const rand = () => {
	seed = (seed * 1664525 + 1013904223) % 2 ** 32;
	return seed / 2 ** 32;
};

// ---- 48 ranks = TP 4 × DP 3 × PP 4 on 12 servers of 4
// GPUs. Most ranks take ~2.1 s per step; ranks 32, 40 and 41 are computational stragglers.
// (Illustrative numbers.)
const job48 = Array.from({ length: 48 }, () => 2.06 + rand() * 0.06);
Object.assign(job48, { 32: 2.46, 40: 2.44, 41: 2.43, 16: 2.17, 18: 2.18, 26: 2.19, 24: 2.02, 22: 2.02, 47: 2.02 });
const clusterNet = { gpusPerServer: 4, serversPerPod: 3, spinesPerPod: 4 };

// ---- 128 ranks = TP 8 × DP 4 × PP 4 on 8-GPU servers; one slow GPU in stage 2.
const big = Array.from({ length: 128 }, () => 1.8 + rand() * 0.06);
big[77] = 2.2;

// ---- 64 ranks = TP 2 × CP 2 × DP 4 × PP 4, with EP 4 for the MoE layers. One slow GPU.
const moe = Array.from({ length: 64 }, () => 1.5 + rand() * 0.05);
moe[21] = 1.78;

const scaleNames = Object.keys(COLOR_SCALES) as ColorScaleName[];
---

<Layout title="LogicalDistributedTopology demo">
	<h1>LogicalDistributedTopology demo</h1>
	<p>
		A training job laid out by its parallel coordinates instead of by host: columns are pipeline stages, rows are
		data-parallel replicas and each cell is a tensor-parallel group, so every group is a straight line. Hover or
		click a rank to see its groups.
	</p>

	<h2>48 ranks with three stragglers</h2>
	<LogicalDistributedTopology
		parallel={{ tp: 4, dp: 3, pp: 4 }}
		values={job48}
		domain={[2.0, 2.5]}
		unit="s"
		valueLabel="compute time"
		network={clusterNet}
		selected={20}
		title="48 ranks: 4 stages × 3 replicas × 4 TP shards"
	/>

	<h2>Rank order tp, pp, dp on the same cluster</h2>
	<p>
		The groups look identical here (the logical view doesn't change), but the hop labels do: data-parallel peers are
		now 5 switches apart instead of 1.
	</p>
	<LogicalDistributedTopology
		parallel={{ tp: 4, dp: 3, pp: 4 }}
		order={["tp", "pp", "dp"]}
		values={job48}
		domain={[2.0, 2.5]}
		unit="s"
		valueLabel="compute time"
		network={clusterNet}
		selected={20}
	/>

	<h2>128 ranks, TP 8 per server</h2>
	<LogicalDistributedTopology
		parallel={{ tp: 8, dp: 4, pp: 4 }}
		values={big}
		colors="viridis"
		unit="s"
		valueLabel="compute time"
		network={{ gpusPerServer: 8, serversPerPod: 4, spinesPerPod: 4 }}
		commColors={{ tp: "#e8590c", dp: "#1971c2", pp: "#2f9e44" }}
		selected={77}
	/>

	<h2>Context parallelism</h2>
	<p>
		Each cell now holds one block per context-parallel chunk: the sequence is split across the blocks, and each
		block is a tensor-parallel group. A CP group is a vertical line inside a cell, next to the DP line that
		continues to the other replicas.
	</p>
	<LogicalDistributedTopology
		parallel={{ tp: 2, cp: 2, dp: 2, pp: 3 }}
		network={{ gpusPerServer: 4, serversPerPod: 2, spinesPerPod: 2 }}
		selected={5}
		title="24 ranks: 3 stages × 2 replicas × 2 CP chunks × 2 TP shards"
	/>

	<h2>Expert parallelism</h2>
	<p>
		Expert parallelism adds no ranks: MoE layers regroup each position's context-parallel and data-parallel ranks
		into expert-parallel groups (Megatron-Core's layout), so an EP group runs down one column, through the CP
		chunks first and then across replicas.
	</p>
	<LogicalDistributedTopology
		parallel={{ tp: 2, cp: 2, dp: 4, pp: 4, ep: 4 }}
		values={moe}
		unit="s"
		valueLabel="compute time"
		network={{ gpusPerServer: 8, serversPerPod: 4, spinesPerPod: 4 }}
		selected={21}
		title="64 ranks: TP 2 × CP 2 × DP 4 × PP 4, EP 4"
	/>

	<h2>Expert parallelism without CP</h2>
	<LogicalDistributedTopology parallel={{ tp: 4, dp: 4, pp: 2, ep: 2 }} selected={6} />

	<h2>Without values or a network</h2>
	<LogicalDistributedTopology parallel={{ tp: 2, dp: 4, pp: 3 }} selected={9} />

	<h2>Colour scales</h2>
	<p>
		Pass any of these as <code>colors</code>, or an array of hex stops such as
		<code>{`["#e0f2fe", "#1e3a8a"]`}</code>.
	</p>
	<ul class="scales">
		{
			scaleNames.map((name) => (
				<li>
					<code>{name}</code>
					<span class="swatch" style={`background: ${colorScale(name, [0, 1]).gradient()}`} />
				</li>
			))
		}
	</ul>
</Layout>

<style>
	.scales {
		list-style: none;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
		gap: 0.5rem 1.5rem;
	}
	.scales li {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin: 0;
	}
	.scales code {
		width: 4.5rem;
		font-size: 0.8rem;
	}
	.swatch {
		flex: 1;
		height: 0.9rem;
		border-radius: 3px;
		border: 1px solid var(--faint);
	}
</style>
