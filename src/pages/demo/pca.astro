---
import Layout from "../../layouts/Layout.astro";
import PcaExplorer from "../../utils/statistics/PcaExplorer.astro";
import { irisGroups, irisScores, irisSpecies } from "../../utils/statistics/pcaFigures";
---

<Layout title="PCA explorer">
	<main>
		<h1>PCA explorer</h1>
		<h2>Direction mode</h2>
		<PcaExplorer
			title="Ten points, line at a chosen angle"
			points={[[1, 1], [2, 1], [3, 3], [5, 6], [6, 5], [7, 5], [8, 7], [9, 3], [9, 4], [10, 5]]}
			caption="Variance along the line peaks at PC1 (26.6°), where the mean squared distance is smallest."
		/>
		<h2>Direction mode, negative correlation and a starting angle</h2>
		<PcaExplorer
			points={[[-2, 2.1], [2, -1.8], [-1, 1.2], [1, -1.1], [0.5, 0.2], [-0.4, -0.1]]}
			angle={45}
			xLabel="a"
			yLabel="b"
		/>
		<h2>Scatter mode</h2>
		<PcaExplorer
			mode="scatter"
			title="Iris flowers on their first two principal components"
			points={irisScores}
			groups={irisGroups}
			groupNames={irisSpecies}
			xLabel="PC1"
			yLabel="PC2"
		/>
	</main>
</Layout>

<style>
	main { max-width: 780px; margin: 3rem auto; padding: 0 1rem; }
</style>
