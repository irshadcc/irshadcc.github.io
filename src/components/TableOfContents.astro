---
// Post navigation drawn as a vertical timeline: one dot per heading on a shared line, top-level
// headings as larger dots and sub-headings indented under them. While reading, the section in
// view is highlighted and the line fills in up to it, so the rail doubles as a progress bar.
// Placed in the left margin by Layout.astro (slot="toc"); hidden on screens too narrow for it.
// Usage in a page:  <TableOfContents slot="toc" headings={headings} />
import type { MarkdownHeading } from "astro";

interface Props {
	headings: MarkdownHeading[];
}

const { headings } = Astro.props;
// Shallowest heading in the list counts as level 0, so a post that starts at ## still lines up.
const top = Math.min(...headings.map((h) => h.depth));
---

<nav class="toc" aria-label="Contents">
	<p class="toc-title">Contents</p>
	<div class="toc-track">
		<span class="toc-progress" aria-hidden="true"></span>
		<ol class="toc-list">
		{
			headings.map((h) => (
				<li class={`toc-item level-${Math.min(h.depth - top, 2)}`}>
					<a href={`#${h.slug}`} data-slug={h.slug}>
						<span class="toc-dot" aria-hidden="true" />
						<span class="toc-text">{h.text}</span>
					</a>
				</li>
			))
		}
		</ol>
	</div>
</nav>

<script>
	// Scroll spy: the active section is the last heading that has scrolled above a line near
	// the top of the viewport. Items before it are marked done, and the progress line is
	// stretched down to the active dot.
	for (const nav of document.querySelectorAll<HTMLElement>(".toc")) {
		const links = [...nav.querySelectorAll<HTMLAnchorElement>("a[data-slug]")];
		const targets = links.map((a) => document.getElementById(a.dataset.slug ?? ""));
		const progress = nav.querySelector<HTMLElement>(".toc-progress");
		const list = nav.querySelector<HTMLElement>(".toc-track");
		let current = -2;

		const update = () => {
			const line = Math.min(140, window.innerHeight * 0.25);
			let active = -1;
			targets.forEach((el, i) => {
				if (el && el.getBoundingClientRect().top <= line) active = i;
			});
			// At the very bottom the last sections may never reach the line; finish the rail.
			if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2) {
				active = links.length - 1;
			}
			if (active === current) return;
			current = active;
			links.forEach((a, i) => {
				const li = a.parentElement;
				li?.classList.toggle("active", i === active);
				li?.classList.toggle("done", i < active);
				if (i === active) a.setAttribute("aria-current", "location");
				else a.removeAttribute("aria-current");
			});
			if (progress && list) {
				const dot = active >= 0 ? links[active].querySelector<HTMLElement>(".toc-dot") : null;
				const listTop = list.getBoundingClientRect().top;
				const h = dot ? dot.getBoundingClientRect().top + dot.offsetHeight / 2 - listTop : 0;
				progress.style.height = `${Math.max(h, 0)}px`;
			}
			// Keep the active item visible when the list is taller than the screen.
			links[active]?.scrollIntoView({ block: "nearest" });
		};

		let queued = false;
		const onScroll = () => {
			if (queued) return;
			queued = true;
			requestAnimationFrame(() => {
				queued = false;
				update();
			});
		};
		window.addEventListener("scroll", onScroll, { passive: true });
		window.addEventListener("resize", () => {
			current = -2; // force the progress line to be re-measured
			onScroll();
		});
		update();
	}
</script>

<style>
	.toc {
		position: sticky;
		top: 2rem;
		max-height: calc(100vh - 4rem);
		overflow-y: auto;
		font-family: var(--sans);
		font-size: 0.7rem;
		line-height: 1.35;
		color: var(--muted);
		opacity: 0.85;
		scrollbar-width: thin;
	}
	.toc-title {
		margin-bottom: 0.6rem;
		font-size: 0.62rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--muted);
	}
	/* The timeline: a faint line behind the dots, and an accent line over it up to the active dot. */
	.toc-track {
		--rail-x: 0.3rem;
		position: relative;
	}
	.toc-list {
		list-style: none;
		padding: 0;
	}
	.toc-track::before,
	.toc-progress {
		content: "";
		position: absolute;
		top: 0.45rem;
		left: calc(var(--rail-x) - 0.5px);
		width: 1px;
		border-radius: 1px;
	}
	.toc-track::before {
		bottom: 0.45rem;
		background: var(--faint);
	}
	.toc-progress {
		height: 0;
		background: var(--muted);
		transition: height 0.2s ease;
	}
	.toc-item a {
		position: relative;
		display: flex;
		align-items: flex-start;
		gap: 0.55rem;
		padding: 0.22rem 0;
		color: var(--muted);
		text-decoration: none;
		border: 0;
	}
	.toc-item a:hover {
		color: var(--text);
	}
	.toc-item a:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
		border-radius: 3px;
	}
	.toc-dot {
		flex: none;
		position: relative;
		z-index: 1;
		width: 0.6rem;
		height: 0.6rem;
		margin-top: 0.05rem;
		display: grid;
		place-items: center;
	}
	.toc-dot::after {
		content: "";
		width: 0.4rem;
		height: 0.4rem;
		border-radius: 50%;
		background: var(--bg);
		border: 1.5px solid var(--faint);
		transition:
			background 0.2s,
			border-color 0.2s,
			transform 0.2s;
	}
	.level-0 a {
		font-weight: 600;
	}
	.level-0 .toc-dot::after {
		width: 0.55rem;
		height: 0.55rem;
	}
	.level-1 .toc-text {
		padding-left: 0.3rem;
	}
	.level-2 .toc-text {
		padding-left: 0.8rem;
	}
	.level-0:not(:first-child) {
		margin-top: 0.4rem;
	}
	.toc-item.done .toc-dot::after {
		background: var(--muted);
		border-color: var(--muted);
	}
	.toc-item.active .toc-dot::after {
		background: var(--bg);
		border-color: var(--text);
		transform: scale(1.2);
	}
	.toc-item.active a {
		color: var(--text);
	}
</style>
