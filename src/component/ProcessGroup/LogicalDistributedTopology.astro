---
// A parallel training job laid out by its parallel coordinates rather than by host.
// A per-host heat map draws ranks inside their hosts, so TP, DP and PP groups scatter and need
// dashed connectors. Here:
//
//   columns = pipeline stages (PP), left to right in the direction activations flow
//   rows    = data-parallel replicas (DP)
//   cells   = one replica's share of one stage: a block per context-parallel chunk (CP),
//             stacked top to bottom, each a tensor-parallel group (TP) with one square per shard
//
// so every group is a straight line: a TP group is one block, a CP group is a vertical line
// through the same square of every block in a cell, a DP group is a vertical line through the
// same square of every row, and a pipeline is a horizontal line through the same square of every
// column. An expert-parallel group (EP, carved out of CP × DP; see parallelism.ts) is a run of
// consecutive squares down one column, drawn as a capsule. Distribution strips along the top (per stage) and right (per
// replica) show every rank's value and mark the slowest, since synchronous training runs at
// the pace of its slowest rank.
//
// With `network` (see network.ts; rank r runs on GPU r), cells name their hosts and each
// group's link is labelled with the switches its traffic crosses.
// Usage in .mdx:
//   <LogicalDistributedTopology parallel={{ tp: 4, dp: 3, pp: 4 }} values={times} unit="s"
//     network={{ gpusPerServer: 4, serversPerPod: 3, spinesPerPod: 4 }} />
//   <LogicalDistributedTopology parallel={{ tp: 2, cp: 2, dp: 4, pp: 2, ep: 4 }} />
import { type ColorScaleSpec, colorScale } from "./colorScales";
import { ClusterNetwork, type HopClass, type NetworkShape } from "./network";
import { type Axis, DIMS, DIM_NAMES, type Degrees, type Dim, ParallelLayout } from "./parallelism";

interface Props {
	/** Parallel degrees; cp and ep default to 1, and ep must divide cp × dp. */
	parallel: Degrees;
	/**
	 * Rank numbering, fastest-varying dimension first (Megatron-LM default: tp, cp, dp, pp).
	 * cp may be left out, and then goes right after tp.
	 */
	order?: Axis[];
	/** One value per rank, e.g. compute time per step. */
	values?: number[] | Record<number, number>;
	/** Colour scale for the values (see colorScales.ts). */
	colors?: ColorScaleSpec;
	domain?: [number, number];
	unit?: string;
	valueLabel?: string;
	/** Physical cluster shape; adds host names and hop counts. */
	network?: NetworkShape;
	/** Rank selected initially. */
	selected?: number;
	/** Override the TP / CP / EP / DP / PP colours. */
	commColors?: Partial<Record<Dim, string>>;
	title?: string;
}

const {
	parallel,
	order = ["tp", "cp", "dp", "pp"],
	values,
	colors = "pinkRed",
	domain: domainProp,
	unit = "",
	valueLabel = "time",
	network,
	selected,
	commColors = {},
	title,
} = Astro.props;

const layout = new ParallelLayout(parallel, order);
const N = layout.size;
const { tp: T, cp: C, dp: D, pp: P } = layout.degrees;
const active = DIMS.filter((d) => layout.degrees[d] > 1);
const net = network ? new ClusterNetwork(network) : undefined;

// ---- Values: e.g. compute time per rank.
const valueOf = (rank: number): number | undefined => {
	const v = Array.isArray(values) ? values[rank] : values?.[rank];
	return typeof v === "number" && Number.isFinite(v) ? v : undefined;
};
const vals = Array.from({ length: N }, (_, r) => valueOf(r));
const known = vals.filter((v): v is number => v !== undefined);
const hasValues = known.length > 0;
const valueDomain: [number, number] = domainProp ?? [Math.min(...known), Math.max(...known)];
const scale = hasValues ? colorScale(colors, valueDomain) : undefined;
const maxV = hasValues ? Math.max(...known) : 0;
const slowest = vals.indexOf(maxV);
const fmt = (v: number) => (Number.isInteger(v) ? `${v}` : Number(v.toPrecision(3)).toString());
const withUnit = (v: number) => (unit ? `${fmt(v)} ${unit}` : fmt(v));

// ---- Geometry (px).
const S = 24; // square per TP shard
const PAD = 6; // cell padding
const tpCols = Math.min(T, 4);
const tpRows = Math.ceil(T / tpCols);
const BLOCK_H = tpRows * S; // one CP chunk's TP group
const BLOCK_GAP = 12; // between CP chunks
const BADGE = net ? 13 : 0; // host line under the squares
const cellW = tpCols * S + 2 * PAD;
const cellH = C * BLOCK_H + (C - 1) * BLOCK_GAP + 2 * PAD + BADGE;
// With CP, the CP and DP lines both run down a column; offset them so both stay visible.
const LINE_OFF = C > 1 ? 4 : 0;
const COL_GAP = 34;
const ROW_GAP = 18;
const MARGIN = 12;
const LEFT = 70; // row labels
const STRIP_H = hasValues ? 38 : 0; // per-stage strips above the grid
const HEADER = 20;
const gridX0 = MARGIN + LEFT;
const gridY0 = MARGIN + STRIP_H + HEADER;
const cellX = (p: number) => gridX0 + p * (cellW + COL_GAP);
const cellY = (d: number) => gridY0 + d * (cellH + ROW_GAP);
const blockY = (d: number, c: number) => cellY(d) + PAD + c * (BLOCK_H + BLOCK_GAP);
const gridRight = cellX(P - 1) + cellW;
const gridBottom = cellY(D - 1) + cellH;
const RS_X = gridRight + 26; // per-replica strips right of the grid
const RS_W = 96;
const W = hasValues ? RS_X + RS_W + 56 + MARGIN : gridRight + MARGIN;
const H = gridBottom + MARGIN;

const squares = Array.from({ length: N }, (_, rank) => {
	const c = layout.coordOf(rank);
	const x = cellX(c.pp) + PAD + (c.tp % tpCols) * S;
	const y = blockY(c.dp, c.cp) + Math.floor(c.tp / tpCols) * S;
	const v = vals[rank];
	return {
		rank,
		c,
		x,
		y,
		cx: x + S / 2,
		cy: y + S / 2,
		fill: v !== undefined && scale ? scale.color(v) : undefined,
		ink: v !== undefined && scale ? scale.text(v) : undefined,
	};
});

// ---- Hosts and hops (only with `network`).
const serverOf = (r: number) => net?.place(r).server;
const hopOf = (a: number, b: number): HopClass | undefined => net?.route(a, b).cls;
const HOP_SHORT: Record<HopClass, string> = { nvlink: "NVLink", tor: "1 switch", spine: "3 switches", core: "5 switches" };
const hostLabel = (ranks: number[]) => {
	const hs = [...new Set(ranks.map(serverOf))].filter((h): h is number => h !== undefined).sort((a, b) => a - b);
	if (!hs.length) return "";
	return hs.length === 1 ? `host ${hs[0]}` : `hosts ${hs[0]}–${hs[hs.length - 1]}`;
};

// ---- Cells (one per replica and stage), TP blocks (one per CP chunk) and the group lines.
const cells = Array.from({ length: D * P }, (_, i) => {
	const d = Math.floor(i / P);
	const p = i % P;
	const ranks = squares.filter((s) => s.c.dp === d && s.c.pp === p).map((s) => s.rank);
	return { d, p, x: cellX(p), y: cellY(d), host: hostLabel(ranks) };
});
const tpBlocks = layout.groups("tp").map((g) => {
	const s = squares[g[0]];
	return { ranks: g, x: cellX(s.c.pp) + PAD - 3, y: blockY(s.c.dp, s.c.cp) - 3 };
});
const cpLines = layout.groups("cp").map((g) => ({
	ranks: g,
	segs: g.slice(1).map((b, i) => ({ x: squares[b].cx - LINE_OFF, y1: squares[g[i]].y + S, y2: squares[b].y })),
}));
const dpLines = layout.groups("dp").map((g) => ({
	ranks: g,
	segs: g.slice(1).map((b, i) => {
		const sa = squares[g[i]];
		const sb = squares[b];
		// Hop label sits in the gap above b's cell, clear of any squares.
		return { x: sa.cx + LINE_OFF, y1: sa.y + S, y2: sb.y, ly: cellY(sb.c.dp) - ROW_GAP / 2 + 3, hop: hopOf(g[i], b) };
	}),
}));
// An EP group is a contiguous run down one column (CP chunks, then replicas), so a capsule.
const epCapsules = layout.groups("ep").map((g) => {
	const first = squares[g[0]];
	const last = squares[g[g.length - 1]];
	return { ranks: g, x: first.x - 3, y: first.y - 3, h: last.y + S - first.y + 6 };
});
const ppLines = layout.groups("pp").map((g) => ({
	ranks: g,
	segs: g.slice(1).map((b, i) => {
		const sa = squares[g[i]];
		const sb = squares[b];
		return { x1: cellX(sa.c.pp) + cellW, x2: cellX(sb.c.pp), y: sa.cy, hop: hopOf(g[i], b) };
	}),
}));

// ---- Distribution strips: every rank's value on a small axis, slowest marked.
const sx = (x0: number, w: number, v: number) => {
	const [lo, hi] = valueDomain;
	const t = hi === lo ? 0.5 : Math.min(1, Math.max(0, (v - lo) / (hi - lo)));
	return x0 + t * w;
};
const strip = (ranks: number[]) => {
	const vs = ranks.map((r) => ({ r, v: vals[r] })).filter((x): x is { r: number; v: number } => x.v !== undefined);
	const worst = vs.reduce((m, x) => (x.v > m.v ? x : m), vs[0]);
	return { vs, worst };
};
const stageStrips = hasValues
	? Array.from({ length: P }, (_, p) => ({ p, ...strip(squares.filter((s) => s.c.pp === p).map((s) => s.rank)) }))
	: [];
const replicaStrips = hasValues
	? Array.from({ length: D }, (_, d) => ({ d, ...strip(squares.filter((s) => s.c.dp === d).map((s) => s.rank)) }))
	: [];

// ---- Text: per-rank description (info panel).
// Each rank gets a heading and one labelled row per fact, e.g.
//   Rank 20 · stage 1, replica 2, TP shard 0 · host 5
//   Time        2.1 s
//   TP peers    21, 22, 23 · over NVLink
//   Pipeline    rank 8 (previous stage), rank 32 (next stage) · 5 switches away
const HOP_PHRASE: Record<HopClass, string> = {
	nvlink: "over NVLink",
	tor: "1 switch away",
	spine: "3 switches away",
	core: "5 switches away",
};
const PEER_LABEL: Record<Dim, string> = {
	tp: "TP peers",
	cp: "CP peers",
	ep: "EP peers",
	dp: "DP peers",
	pp: "Pipeline",
};
const info = squares.map((s) => {
	const r = s.rank;
	const where = [`stage ${s.c.pp}`, `replica ${s.c.dp}`, ...(C > 1 ? [`CP chunk ${s.c.cp}`] : []), `TP shard ${s.c.tp}`];
	const host = serverOf(r);
	const head = `Rank ${r} · ${where.join(", ")}${host !== undefined ? ` · host ${host}` : ""}`;
	const rows: [string, string][] = [];
	const v = vals[r];
	if (v !== undefined) {
		const label = valueLabel.charAt(0).toUpperCase() + valueLabel.slice(1);
		rows.push([label, r === slowest ? `${withUnit(v)}, the slowest rank` : withUnit(v)]);
	}
	for (const dim of active) {
		const g = layout.groupOf(dim, r);
		const i = g.indexOf(r);
		const peers = dim === "pp" ? [g[i - 1], g[i + 1]].filter((p) => p !== undefined) : g.filter((p) => p !== r);
		const name = (p: number) => (dim === "pp" ? `rank ${p} (${p < r ? "previous" : "next"} stage)` : `${p}`);
		if (!net) {
			rows.push([PEER_LABEL[dim], peers.map(name).join(", ")]);
			continue;
		}
		const byHop = new Map<HopClass, number[]>();
		for (const p of peers) {
			const h = hopOf(r, p) as HopClass;
			byHop.set(h, [...(byHop.get(h) ?? []), p]);
		}
		rows.push([PEER_LABEL[dim], [...byHop].map(([h, ps]) => `${ps.map(name).join(", ")} · ${HOP_PHRASE[h]}`).join("; ")]);
	}
	return { head, rows };
});
const infoTitle = info.map(({ head, rows }) => [head, ...rows.map(([k, t]) => `${k}: ${t}`)].join("\n"));
const infoLines = Math.max(1, ...info.map((t) => 1 + t.rows.length));

const hash = [...JSON.stringify(Astro.props)].reduce((h, c) => (h * 31 + c.charCodeAt(0)) >>> 0, 7).toString(36);
const arrowId = `lg-arrow-${hash}`;
// "tensor-, context- and pipeline-parallel"
const names = active.map((d) => DIM_NAMES[d].split(" ")[0].toLowerCase());
const dimList = names.length < 2 ? names.join("") : `${names.slice(0, -1).join("-, ")}- and ${names[names.length - 1]}`;
const hint = active.length ? `Hover or click a rank to see its ${dimList}-parallel groups.` : "";
const commStyle = DIMS.filter((d) => commColors[d])
	.map((d) => `--${d}: ${commColors[d]}`)
	.join("; ");
---

<figure class="logical" style={commStyle || undefined} data-selected={selected}>
	{title && <figcaption class="title">{title}</figcaption>}
	<div class="legend">
		{
			active.map((d) => (
				<span class="key">
					<span class={`swatch-line ${d}`} />
					{DIM_NAMES[d]} ({d.toUpperCase()} = {layout.degrees[d]})
				</span>
			))
		}
	</div>
	{
		hasValues && scale && (
			<div class="legend">
				<span class="key">
					{valueLabel}: {withUnit(valueDomain[0])}
					<span class="bar" style={`background: ${scale.gradient()}`} />
					{withUnit(valueDomain[1])}
				</span>
			</div>
		)
	}

	<div class="canvas">
		<svg
			viewBox={`0 0 ${W} ${H}`}
			width={W}
			height={H}
			style={`min-width: ${Math.round(W * 0.75)}px`}
			role="group"
			aria-label={title ??
				`${N} ranks: ${P} pipeline stages × ${D} data-parallel replicas${C > 1 ? ` × ${C} context-parallel chunks` : ""} × ${T} tensor-parallel shards`}
		>
			<defs>
				<marker
					id={arrowId}
					viewBox="0 0 8 8"
					refX="8"
					refY="4"
					markerWidth="6"
					markerHeight="6"
					orient="auto-start-reverse"
				>
					<path class="arrowhead" d="M0,0.5 L8,4 L0,7.5 z" />
				</marker>
			</defs>

			<!-- Stage headers, with the direction of the pipeline between them. -->
			{
				Array.from({ length: P }, (_, p) => (
					<text class="header" x={cellX(p) + cellW / 2} y={gridY0 - 7}>
						stage {p}
					</text>
				))
			}
			{
				Array.from({ length: P - 1 }, (_, p) => (
					<text class="flow" x={cellX(p) + cellW + COL_GAP / 2} y={gridY0 - 7}>
						→
					</text>
				))
			}
			{
				Array.from({ length: D }, (_, d) => (
					<text class="row-label" x={MARGIN} y={cellY(d) + cellH / 2 + 4}>
						replica {d}
					</text>
				))
			}

			<!-- Distribution strips: a tick per rank, the slowest marked with a dot and its value. -->
			{
				stageStrips.map((st) => {
					const x0 = cellX(st.p) + 6;
					const w = cellW - 12;
					const base = MARGIN + STRIP_H - 6;
					const wx = sx(x0, w, st.worst.v);
					return (
						<g class={`strip${st.worst.r === slowest ? " worst" : ""}`}>
							<line class="axis" x1={x0} y1={base} x2={x0 + w} y2={base} />
							{st.vs.map((x) => (
								<line class="tick" x1={sx(x0, w, x.v)} y1={base - 7} x2={sx(x0, w, x.v)} y2={base} />
							))}
							<circle cx={wx} cy={base - 3.5} r="3.5" style={scale && `fill: ${scale.color(st.worst.v)}`} />
							<text class="max" x={Math.min(Math.max(wx, x0 + 16), x0 + w - 16)} y={base - 11}>
								{withUnit(st.worst.v)}
							</text>
						</g>
					);
				})
			}
			{
				hasValues && (
					<text class="strip-caption" x={MARGIN} y={MARGIN + STRIP_H - 16}>
						<tspan x={MARGIN}>slowest</tspan>
						<tspan x={MARGIN} dy="11">per stage</tspan>
					</text>
				)
			}
			{
				replicaStrips.map((st) => {
					const base = cellY(st.d) + cellH / 2 + 4;
					const wx = sx(RS_X, RS_W, st.worst.v);
					return (
						<g class={`strip${st.worst.r === slowest ? " worst" : ""}`}>
							<line class="axis" x1={RS_X} y1={base} x2={RS_X + RS_W} y2={base} />
							{st.vs.map((x) => (
								<line class="tick" x1={sx(RS_X, RS_W, x.v)} y1={base - 7} x2={sx(RS_X, RS_W, x.v)} y2={base} />
							))}
							<circle cx={wx} cy={base - 3.5} r="3.5" style={scale && `fill: ${scale.color(st.worst.v)}`} />
							<text class="max end" x={RS_X + RS_W + 8} y={base}>
								{withUnit(st.worst.v)}
							</text>
						</g>
					);
				})
			}
			{hasValues && <text class="strip-caption" x={RS_X} y={gridY0 - 7}>slowest per replica</text>}

			<!-- TP cells. -->
			{
				cells.map((c) => (
					<g class="cell">
						<rect x={c.x} y={c.y} width={cellW} height={cellH} rx="6" />
						{c.host && (
							<text x={c.x + cellW / 2} y={c.y + cellH - 5}>
								{c.host}
							</text>
						)}
					</g>
				))
			}

			<!-- Group overlays, hidden until a member is selected. -->
			{
				epCapsules.map((e) => (
					<g class="grp ep" data-dim="ep" data-ranks={e.ranks.join(",")}>
						<rect x={e.x} y={e.y} width={S + 6} height={e.h} rx="6" />
					</g>
				))
			}
			{
				tpBlocks.map((b) => (
					<g class="grp tp" data-dim="tp" data-ranks={b.ranks.join(",")}>
						<rect x={b.x} y={b.y} width={tpCols * S + 6} height={BLOCK_H + 6} rx="5" />
					</g>
				))
			}
			{
				cpLines.map((g) => (
					<g class="grp cp" data-dim="cp" data-ranks={g.ranks.join(",")}>
						{g.segs.map((s) => (
							<line x1={s.x} y1={s.y1} x2={s.x} y2={s.y2} />
						))}
					</g>
				))
			}
			{
				dpLines.map((g) => (
					<g class="grp dp" data-dim="dp" data-ranks={g.ranks.join(",")}>
						{g.segs.map((s) => (
							<>
								<line x1={s.x} y1={s.y1} x2={s.x} y2={s.y2} />
								{s.hop && (
									<text class="hop" x={s.x + 5} y={s.ly}>
										{HOP_SHORT[s.hop]}
									</text>
								)}
							</>
						))}
					</g>
				))
			}
			{
				ppLines.map((g) => (
					<g class="grp pp" data-dim="pp" data-ranks={g.ranks.join(",")}>
						{g.segs.map((s) => (
							<>
								<line x1={s.x1 + 2} y1={s.y} x2={s.x2 - 2} y2={s.y} marker-end={`url(#${arrowId})`} />
								{s.hop && (
									<text class="hop mid" x={(s.x1 + s.x2) / 2} y={s.y - 5}>
										{HOP_SHORT[s.hop].replace(" switches", " sw").replace(" switch", " sw")}
									</text>
								)}
							</>
						))}
					</g>
				))
			}

			<!-- One square per rank. -->
			{
				squares.map((s) => (
					<g
						class={`rank${s.rank === slowest ? " slowest" : ""}`}
						data-rank={s.rank}
						data-fill={s.fill}
						tabindex="0"
						role="button"
						aria-label={`Rank ${s.rank}`}
					>
						<title>{infoTitle[s.rank]}</title>
						<rect x={s.x + 1} y={s.y + 1} width={S - 2} height={S - 2} rx="3" style={s.fill && `fill: ${s.fill}`} />
						<text x={s.cx} y={s.cy + 3.5} style={s.ink && `fill: ${s.ink}`}>
							{s.rank}
						</text>
					</g>
				))
			}
		</svg>
	</div>

	<div class="info" aria-live="polite" style={`min-height: ${infoLines * 1.45}em`}><p class="hint">{hint}</p></div>
	<div class="info-store" hidden>
		{
			info.map(({ head, rows }) => (
				<div>
					<p class="info-head">{head}</p>
					{rows.length > 0 && (
						<dl class="info-rows">
							{rows.map(([k, t]) => (
								<>
									<dt>{k}</dt>
									<dd>{t}</dd>
								</>
							))}
						</dl>
					)}
				</div>
			))
		}
	</div>
</figure>

<script>
	// Selection highlights the rank's groups (its TP block, its CP and DP lines, its EP capsule
	// and its horizontal pipeline), outlines each peer in the colour of the group it shares with
	// the selection (the closest one when it shares several) and fades every rank outside them.
	for (const fig of document.querySelectorAll<HTMLElement>(".logical")) {
		const info = fig.querySelector<HTMLElement>(".info");
		const hint = info?.firstElementChild;
		const texts = [...fig.querySelectorAll<HTMLElement>(".info-store > div")];
		const ranks = [...fig.querySelectorAll<SVGGElement>(".rank")];
		// Closest groups first: a rank in both the TP block and the DP line counts as a TP peer.
		const closeness = ["tp", "cp", "ep", "dp", "pp"];
		const groups = [...fig.querySelectorAll<SVGGElement>(".grp")].map((el) => ({
			el,
			dim: el.dataset.dim ?? "",
			ranks: new Set((el.dataset.ranks ?? "").split(",").map(Number)),
		}));
		const initial = Number.parseInt(fig.dataset.selected ?? "", 10);
		let pinned: number | null = Number.isInteger(initial) ? initial : null;

		const show = (sel: number | null) => {
			fig.classList.toggle("tracing", sel !== null);
			const peer = new Map<number, string>();
			for (const g of groups) {
				const on = sel !== null && g.ranks.has(sel);
				g.el.classList.toggle("on", on);
				if (!on) continue;
				for (const r of g.ranks) {
					const cur = peer.get(r);
					if (cur === undefined || closeness.indexOf(g.dim) < closeness.indexOf(cur)) peer.set(r, g.dim);
				}
			}
			ranks.forEach((el, r) => {
				el.classList.toggle("selected", r === sel);
				el.classList.toggle("peer", peer.has(r));
				if (peer.has(r) && r !== sel) el.dataset.peer = peer.get(r);
				else delete el.dataset.peer;
				el.setAttribute("aria-pressed", String(r === pinned));
			});
			if (info) {
				const content = sel === null ? hint : texts[sel];
				info.replaceChildren(...(content ? [content.cloneNode(true)] : []));
			}
		};
		const toggle = (r: number) => {
			pinned = pinned === r ? null : r;
			show(pinned);
		};
		ranks.forEach((el, r) => {
			el.addEventListener("pointerenter", () => show(r));
			el.addEventListener("pointerleave", () => show(pinned));
			el.addEventListener("focus", () => show(r));
			el.addEventListener("blur", () => show(pinned));
			el.addEventListener("click", () => toggle(r));
			el.addEventListener("keydown", (e) => {
				if (e.key !== "Enter" && e.key !== " ") return;
				e.preventDefault();
				toggle(r);
			});
		});

		show(pinned);
	}
</script>

