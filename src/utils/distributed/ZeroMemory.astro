---
// Memory per GPU for data parallelism and the three ZeRO stages, with the reader choosing the
// model size and the number of GPUs (accounting in zero.ts). Each bar stacks the 16-bit
// parameters, the 16-bit gradients and the optimizer state; the vertical line is one GPU's
// memory. The last column is the data each GPU sends per training step.
// Usage in .mdx:
//   <ZeroMemory />
//   <ZeroMemory billions={70} n={256} />
import { drawZero } from "./zero";

interface Props {
	/** Model size in billions of parameters; one of the presets below. */
	billions?: number;
	/** Data-parallel GPUs. */
	n?: number;
	/** Memory of one GPU in GB. */
	gpu?: number;
	title?: string;
}

const SIZES = [1.5, 7.5, 13, 70, 175, 405];
const COUNTS = [1, 2, 4, 8, 16, 32, 64, 128, 256, 512, 1024];
const { billions = 7.5, n = 64, gpu = 80, title } = Astro.props;
---

<figure class="zero" data-gpu={gpu}>
	{title && <figcaption class="title">{title}</figcaption>}
	<div class="knobs">
		<label>
			Model
			<select data-knob="psi">
				{SIZES.map((s) => <option value={s} selected={s === billions}>{s}B parameters</option>)}
			</select>
		</label>
		<label>
			GPUs <i>N</i>
			<input data-knob="n" type="range" min="0" max={COUNTS.length - 1} value={COUNTS.indexOf(n)} />
			<output>{n}</output>
		</label>
	</div>
	<div class="legend">
		<span class="key"><i class="sw p"></i>parameters (2Ψ)</span>
		<span class="key"><i class="sw g"></i>gradients (2Ψ)</span>
		<span class="key"><i class="sw o"></i>optimizer state (12Ψ)</span>
		<span class="key"><i class="sw cap"></i>{gpu} GB GPU</span>
	</div>
	<div class="head">
		<span></span><span></span><span>per GPU</span><span>sent per step</span>
	</div>
	<div class="rows" set:html={drawZero(billions * 1e9, n, gpu * 1e9)} />
</figure>

<script>
	import { drawZero } from "./zero";

	const COUNTS = [1, 2, 4, 8, 16, 32, 64, 128, 256, 512, 1024];
	for (const fig of document.querySelectorAll<HTMLElement>(".zero")) {
		const gpu = Number(fig.dataset.gpu) * 1e9;
		const psiKnob = fig.querySelector<HTMLSelectElement>("[data-knob=psi]");
		const nKnob = fig.querySelector<HTMLInputElement>("[data-knob=n]");
		const out = fig.querySelector("output");
		const rows = fig.querySelector<HTMLElement>(".rows");
		if (!psiKnob || !nKnob || !rows) continue;
		const render = () => {
			const n = COUNTS[Number(nKnob.value)];
			if (out) out.textContent = String(n);
			rows.innerHTML = drawZero(Number(psiKnob.value) * 1e9, n, gpu);
		};
		psiKnob.addEventListener("input", render);
		nKnob.addEventListener("input", render);
	}
</script>

<style>
	.zero {
		--p: #9fc8ef;
		--g: #a9dba6;
		--o: #f5d38c;
		margin: 1.75rem 0;
		font-family: var(--sans);
		font-size: 0.78rem;
	}
	.title {
		font-size: 0.9rem;
		font-weight: 600;
		text-align: center;
		margin-bottom: 0.5rem;
	}
	.knobs {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.4rem 1.5rem;
		margin-bottom: 0.5rem;
		color: var(--muted);
	}
	.knobs label {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
	}
	.knobs select {
		font: inherit;
		color: var(--text);
		background: var(--bg);
		border: 1px solid var(--faint);
		border-radius: 6px;
	}
	.knobs input {
		width: 8rem;
		accent-color: var(--accent);
	}
	.knobs output {
		min-width: 2.2rem;
		font-family: var(--mono);
		color: var(--text);
	}
	.legend {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.3rem 1rem;
		margin-bottom: 0.6rem;
		font-size: 0.72rem;
		color: var(--muted);
	}
	.key {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
	}
	.sw {
		width: 0.8rem;
		height: 0.8rem;
		border-radius: 2px;
	}
	.sw.p { background: var(--p); }
	.sw.g { background: var(--g); }
	.sw.o { background: var(--o); }
	.sw.cap {
		width: 2px;
		background: var(--text);
		border-radius: 0;
	}
	.head,
	.rows :global(.row) {
		display: grid;
		grid-template-columns: 7.5rem 1fr 4.5rem 5.5rem;
		align-items: center;
		gap: 0.6rem;
	}
	.head {
		font-size: 0.7rem;
		color: var(--muted);
		text-align: right;
	}
	.rows :global(.row) {
		padding: 0.3rem 0;
	}
	.rows :global(.name) {
		display: flex;
		flex-direction: column;
		line-height: 1.25;
	}
	.rows :global(.name span) {
		font-size: 0.7rem;
		color: var(--muted);
	}
	.rows :global(.track) {
		position: relative;
		display: flex;
		height: 1.3rem;
		background: var(--surface);
		border-radius: 3px;
	}
	.rows :global(.seg) {
		height: 100%;
		transition: width 200ms ease;
	}
	.rows :global(.seg.p) { background: var(--p); border-radius: 3px 0 0 3px; }
	.rows :global(.seg.g) { background: var(--g); }
	.rows :global(.seg.o) { background: var(--o); }
	.rows :global(.cap) {
		position: absolute;
		top: -3px;
		bottom: -3px;
		width: 2px;
		background: var(--text);
	}
	.rows :global(.num) {
		font-family: var(--mono);
		text-align: right;
	}
	.rows :global(.num.fits) {
		font-weight: 600;
	}
	.rows :global(.num.over) {
		color: #d0574f;
		font-weight: 600;
	}
	.rows :global(.num.traffic) {
		color: var(--muted);
	}
	@media (max-width: 560px) {
		.head,
		.rows :global(.row) {
			grid-template-columns: 5.5rem 1fr 4rem 4.5rem;
			gap: 0.4rem;
		}
	}
</style>
