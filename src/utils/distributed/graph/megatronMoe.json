					"row_labels": ["b0·s0", "b0·s1", "b1·s0", "b1·s1"],
					"col_labels": ["0", "1", "2", "3"],
					"values": [
						["-0.17", "0.18", "-0.27", "-0.02"],
						["0.07", "-0.11", "-0.09", "0.07"],
						["0.00", "0.00", "-0.05", "0.02"],
						["0.00", "-0.01", "-0.01", "0.01"]
					],
					"note": "Checked against layer(hidden_states) and against all four experts applied directly."
				}
			},
			"equation": {
				"title": "Restore the shape",
				"latex": ["Y = y.\\text{view}(B, S, h)"]
			}
		}
	},
	"outputs": {
		"output": "view2.out",
		"aux_loss": "router.aux_loss"
	}
