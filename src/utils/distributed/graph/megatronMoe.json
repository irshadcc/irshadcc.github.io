					],
					"row_tones": [0, 1, 1, 0, 0, 1, 1, 1],
					"note": "Back in the order the rows arrived, grouped by source rank."
				}
			},
			"equation": {
				"title": "Undo the local sort",
				"latex": [
					"\\text{restored}[\\text{local\\_reorder}[i], :] = \\text{out}[i, :]"
				]
			}
		},
		"combine": {
			"type": "function",
			"function": "_AllToAll.apply",
			"inputs": {
				"input_tensor": "restore.out",
				"output_split_sizes": "counts.splits",
				"input_split_sizes": "out_splits.out"
			},
			"operations": {
				"total": {
					"type": "op",
					"op": "builtins.sum",
					"label": "sum(output_split_sizes)",
					"inputs": {
						"input": "output_split_sizes"
					},
					"outputs": {
						"out": {
							"name": "total_out",
							"symbolic_shape": "()",
							"shape": [],
							"axes": ["", ""],
							"row_labels": [""],
							"col_labels": ["value"],
							"values": [["8"]]
						}
					},
					"equation": {
						"title": "Rows this rank will receive",
						"latex": [
							"\\text{total\\_out} = \\sum_s \\text{output\\_split\\_sizes}[s]"
						]
					}
				},
				"empty": {
					"type": "op",
					"op": "torch.empty",
					"label": "empty",
					"inputs": {
						"size": "total.out"
					},
					"outputs": {
						"out": {
							"name": "output_tensor",
							"symbolic_shape": "(total_out, hidden)",
							"shape": [8, 4],
							"note": "Uninitialized: all_to_all_single writes every row."
						}
					},
					"equation": {
						"title": "Allocate the receive buffer",
						"latex": [
							"\\text{output\\_tensor} \\in \\mathbb{R}^{\\text{total\\_out} \\times h}"
						]
					}
				},
				"a2a": {
					"type": "op",
					"op": "dist.all_to_all_single",
					"label": "all_to_all_single",
					"inputs": {
						"output": "empty.out",
						"input": "input_tensor",
						"output_split_sizes": "output_split_sizes",
						"input_split_sizes": "input_split_sizes"
					},
					"outputs": {
						"out": {
							"name": "returned_tokens",
							"symbolic_shape": "(total_tokens·top_k, hidden)",
							"shape": [8, 4],
							"axes": ["Copies", "hidden"],
							"row_labels": [
								"t3→E0",
								"t0→E1",
								"t1→E1",
								"t2→E2",
								"t3→E2",
								"t0→E3",
								"t1→E3",
								"t2→E3"
							],
							"col_labels": ["0", "1", "2", "3"],
							"values": [
								["-0.03", "0.00", "0.02", "0.03"],
								["-0.06", "0.06", "-0.02", "-0.10"],
								["0.17", "-0.21", "-0.20", "0.22"],
								["0.00", "0.00", "-0.12", "0.06"],
								["0.02", "-0.02", "-0.04", "-0.01"],
								["-0.22", "0.24", "-0.39", "0.02"],
								["-0.05", "-0.01", "0.02", "-0.10"],
								["-0.01", "0.00", "0.03", "-0.03"]
							],
							"row_tones": [0, 1, 1, 2, 2, 3, 3, 3],
							"note": "Every copy this rank sent, back in the order it sent them."
						}
					},
					"equation": {
						"title": "All-to-all: combine",
						"latex": [
							"\\text{rank } j \\text{ returns each row of chunk}_{i \\to j} \\text{ to rank } i"
						],
						"note": "The dispatch with the splits swapped."
					},
					"kind": "collective"
				}
			},
			"outputs": {
				"out": "a2a.out"
			}
		},
		"unpermute": {
			"type": "op",
			"op": "Tensor.__setitem__",
			"label": "index_put (unpermute)",
			"inputs": {
				"values": "combine.out",
				"indices": "sort.indices"
			},
			"outputs": {
				"out": {
					"name": "unpermuted_tokens",
					"symbolic_shape": "(total_tokens, top_k, hidden)",
					"shape": [4, 2, 4],
					"axes": ["(Token, k)", "hidden"],
					"row_labels": [
						"t0→E3",
						"t0→E1",
						"t1→E1",
						"t1→E3",
						"t2→E2",
						"t2→E3",
						"t3→E0",
						"t3→E2"
					],
					"col_labels": ["0", "1", "2", "3"],
					"values": [
						["-0.22", "0.24", "-0.39", "0.02"],
						["-0.06", "0.06", "-0.02", "-0.10"],
						["0.17", "-0.21", "-0.20", "0.22"],
						["-0.05", "-0.01", "0.02", "-0.10"],
						["0.00", "0.00", "-0.12", "0.06"],
						["-0.01", "0.00", "0.03", "-0.03"],
						["-0.03", "0.00", "0.02", "0.03"],
						["0.02", "-0.02", "-0.04", "-0.01"]
					],
					"row_tones": [3, 1, 1, 3, 2, 3, 0, 2]
				}
			},
			"equation": {
				"title": "Invert the global permutation",
				"latex": [
					"\\text{unpermuted}[\\text{reorder}[i], :] = \\text{returned}[i, :]"
				],
				"note": "Then view(T, top_k, h): row tK + k is copy k of token t."
			}
		},
		"wsum": {
			"type": "op",
			"op": "torch.mul, Tensor.sum",
			"label": "mul + sum(dim=1)",
			"inputs": {
				"input": "unpermute.out",
				"weights": "router.topk_weights"
			},
			"outputs": {
				"out": {
