					"shape": [8, 4],
					"axes": ["Copies", "hidden"],
					"row_labels": [
						"t3→E0",
						"t6→E0",
						"t7→E0",
						"t0→E1",
						"t1→E1",
						"t4→E1",
						"t5→E1",
						"t6→E1"
					],
					"col_labels": ["0", "1", "2", "3"],
					"values": [
						["-0.03", "0.00", "0.02", "0.03"],
						["0.01", "-0.01", "-0.02", "-0.01"],
						["0.12", "-0.01", "-0.37", "-0.12"],
						["-0.06", "0.06", "-0.02", "-0.10"],
						["0.17", "-0.21", "-0.20", "0.22"],
						["0.00", "0.00", "0.00", "0.01"],
						["0.00", "-0.01", "-0.01", "0.01"],
						["0.00", "0.00", "0.01", "0.00"]
					],
					"row_tones": [0, 0, 0, 1, 1, 1, 1, 1]
				}
			},
			"equation": {
				"title": "Write each expert's rows back",
				"latex": [
					"\\text{out}[o_j : o_j + c_j] = \\text{expert}_j(\\text{inp}_j)"
				]
			}
		},
		"restore": {
			"type": "op",
			"op": "Tensor.__setitem__",
			"label": "index_put (restore)",
			"inputs": {
				"values": "assign.out",
				"indices": "sort_local.indices"
			},
			"outputs": {
				"out": {
					"name": "unpermuted_local_outputs",
					"symbolic_shape": "(rows, hidden)",
					"shape": [8, 4],
					"axes": ["Copies", "hidden"],
					"row_labels": [
						"t3→E0",
						"t0→E1",
						"t1→E1",
						"t6→E0",
						"t7→E0",
						"t4→E1",
						"t5→E1",
						"t6→E1"
					],
					"col_labels": ["0", "1", "2", "3"],
					"values": [
						["-0.03", "0.00", "0.02", "0.03"],
						["-0.06", "0.06", "-0.02", "-0.10"],
						["0.17", "-0.21", "-0.20", "0.22"],
