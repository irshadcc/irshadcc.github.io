					"shape": [4, 4],
					"axes": ["Tokens", "hidden"],
					"row_labels": ["t0", "t1", "t2", "t3"],
					"col_labels": ["0", "1", "2", "3"],
					"values": [
						["-0.17", "0.18", "-0.27", "-0.02"],
						["0.07", "-0.11", "-0.09", "0.07"],
						["0.00", "0.00", "-0.05", "0.02"],
						["0.00", "-0.01", "-0.01", "0.01"]
					]
				}
			},
			"equation": {
				"title": "Weighted combination",
				"latex": ["y_t = \\sum_{k} g_{t,k} \\, \\text{unpermuted}[t, k, :]"]
			}
		},
		"view2": {
			"type": "op",
			"op": "Tensor.view",
			"label": "view(orig_shape)",
			"inputs": {
				"input": "wsum.out"
			},
			"outputs": {
				"out": {
					"name": "output",
