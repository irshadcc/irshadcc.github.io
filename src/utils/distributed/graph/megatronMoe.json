									"symbolic_shape": "(rows, hidden)",
									"shape": [5, 4],
									"axes": ["Copies", "hidden"],
									"row_labels": ["t0→E1", "t1→E1", "t4→E1", "t5→E1", "t6→E1"],
									"col_labels": ["0", "1", "2", "3"],
									"values": [
										["-0.06", "0.06", "-0.02", "-0.10"],
										["0.17", "-0.21", "-0.20", "0.22"],
										["0.00", "0.00", "0.00", "0.01"],
										["0.00", "-0.01", "-0.01", "0.01"],
										["0.00", "0.00", "0.01", "0.00"]
									],
									"row_tones": [1, 1, 1, 1, 1]
								}
							},
							"equation": {
								"title": "Local expert 1: down projection",
								"latex": [
									"y = u W_3^{\\top}, \\quad W_3 \\in \\mathbb{R}^{h \\times f}"
								],
								"note": "f = 8 → h = 4."
							}
						}
					},
					"outputs": {
						"out": "w3.out"
					}
				}
			},
			"outputs": {
				"y0": "0.out",
				"y1": "1.out"
			},
			"layout": {
				"order": ["0", "1"]
			}
		},
		"assign": {
			"type": "op",
			"op": "Tensor.__setitem__ (loop)",
			"label": "slice assign",
			"inputs": {
