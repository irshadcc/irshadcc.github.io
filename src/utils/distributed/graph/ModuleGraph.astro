---
// A PyTorch module drawn as its dataflow graph: every op (and leaf module, such as a Linear) is a
// card, every module with operations a box around its cards, nested as the modules are (function
// calls in dashed boxes), and every tensor a thin right-angled wire with an arrowhead, from the
// op that produced it to each op that reads it. Cards carry an icon (an op, a leaf module, a
// collective, an input or an output), a monospace title and the PyTorch call as a muted subtitle.
// Hovering a card lights its wires and neighbours and shows its equation; hovering a wire shows
// its tensor as a matrix with axis titles and shape. Every box has a − button that collapses it
// into one card, which gets a + button to expand it again; `collapsed` lists the boxes (dotted
// names, "" for the root) that start collapsed. The input is a nested JSON module
// (moduleGraph.ts describes the format), lowered to a flat graph that moduleLayout.ts lays out
// and moduleRender.ts draws, at build time and again in the browser after a toggle.
// Self-contained: it uses no other component. The drawing shrinks to 75% at most, then scrolls.
// Usage in .mdx:
//   import spec from "../../utils/distributed/graph/megatronMoe.json";
//   <ModuleGraph spec={spec} wide collapsed={["local_experts.1"]} />
import katex from "katex";
import { type ModuleSpec, collapse, lower } from "./moduleGraph";
import { layoutModule } from "./moduleLayout";
import { renderSvg } from "./moduleRender";

interface Props {
	spec: ModuleSpec;
	/** Extend into the margin-note column on wide screens. */
	wide?: boolean;
	title?: string;
	/** Boxes (dotted module names, "" for the root) that start collapsed. */
	collapsed?: string[];
}

const { spec, wide = false, title, collapsed = [] } = Astro.props;
const graph = lower(spec);
for (const c of collapsed)
	if (!(c in graph.modules))
		throw new Error(
			`ModuleGraph: collapsed "${c}" is not a module or function with operations`,
		);
const svg = renderSvg(layoutModule(collapse(graph, collapsed)), title);
// What the browser needs to redraw after a toggle: the graph without equations or tensor values.
const clientGraph = {
	nodes: graph.nodes.map(({ equation, ...n }) => n),
	edges: graph.edges.map((e) => ({
		from: e.from,
		to: e.to,
		index: e.index,
		tensor: { name: e.tensor.name, shape: [] },
	})),
	modules: graph.modules,
};
const data = JSON.stringify({ graph: clientGraph, collapsed, title }).replace(
	/</g,
	"\\u003c",
);
const tex = (l: string) =>
	katex.renderToString(l, {
		displayMode: true,
		throwOnError: false,
		output: "html",
	});
const isZero = (v: string) => /^-?0(\.0+)?$/.test(v);
---

<figure class:list={["mg", { wide }]}>
	{title && <figcaption class="mg-title">{title}</figcaption>}
	<div class="mg-canvas">
		<div class="mg-svg" set:html={svg} />
		<script is:inline type="application/json" class="mg-data" set:html={data} />
		{
			graph.nodes
				.filter((n) => n.equation)
				.map((n) => (
					<div class="mg-card eq" data-node={n.id} hidden>
						<p class="card-title">{n.equation?.title}</p>
						{n.equation?.latex.map((l) => <div class="katex-line" set:html={tex(l)} />)}
						{n.equation?.note && <p class="card-note">{n.equation.note}</p>}
					</div>
				))
		}
		{
			graph.edges.map((e) => {
				const t = e.tensor;
				const rows = t.values ?? [];
				const cols = t.col_labels ?? rows[0]?.map((_, j) => `${j}`) ?? [];
				return (
					<div class="mg-card mx-card" data-edge={e.index} hidden>
						<p class="card-title">
							<code>{t.name}</code>
						</p>
						{rows.length > 0 && (
							<table class="mx">
								<tbody>
									<tr>
										<td colspan="2" />
										<th class="ax-col" colspan={cols.length}>
											{t.axes?.[1]}
										</th>
									</tr>
									<tr>
										<td colspan="2" />
										{cols.map((c) => (
											<th class="idx-col">{c}</th>
										))}
									</tr>
									{rows.map((row, r) => (
										<tr class={t.row_tones?.[r] == null ? "" : `tone t${t.row_tones[r]}`}>
											{r === 0 && (
												<th class="ax-row" rowspan={rows.length}>
													<span>{t.axes?.[0]}</span>
												</th>
											)}
											<th class="idx-row">{t.row_labels?.[r] ?? r}</th>
											{row.map((v, j) => (
												<td class:list={{ first: j === 0, nz: !isZero(v) }}>{v}</td>
											))}
										</tr>
									))}
								</tbody>
							</table>
						)}
						<p class="shape-line">
							{t.symbolic_shape && <span class="sym">{t.symbolic_shape} = </span>}
							<span class="concrete">({t.shape.join(", ")})</span>
						</p>
						{t.note && <p class="card-note">{t.note}</p>}
					</div>
				);
			})
		}
	</div>
</figure>

<script>
	import { type LoweredGraph, collapse } from "./moduleGraph";
	import { layoutModule } from "./moduleLayout";
	import { renderSvg } from "./moduleRender";

	for (const fig of document.querySelectorAll<HTMLElement>(".mg")) {
		const canvas = fig.querySelector<HTMLElement>(".mg-canvas");
		const holder = fig.querySelector<HTMLElement>(".mg-svg");
		const dataEl = fig.querySelector<HTMLScriptElement>(".mg-data");
		if (!canvas || !holder || !dataEl) continue;
		const data: { graph: LoweredGraph; collapsed: string[]; title?: string } = JSON.parse(dataEl.textContent ?? "{}");
		const collapsed = new Set(data.collapsed);
		const cards = [...fig.querySelectorAll<HTMLElement>(".mg-card")];
		const hideCards = () => {
			for (const c of cards) c.hidden = true;
		};
		/** Keeps a card inside the canvas: at (x, y), or above `above` if there's no room below. */
		const put = (card: HTMLElement, x: number, y: number, above: number) => {
			const box = canvas.getBoundingClientRect();
			const left = Math.min(Math.max(0, x), Math.max(0, canvas.scrollWidth - card.offsetWidth));
			const top = y + card.offsetHeight > box.height && above - card.offsetHeight > 0 ? above - card.offsetHeight : y;
			card.style.left = `${left}px`;
			card.style.top = `${Math.max(0, top)}px`;
		};
		const local = (r: DOMRect) => {
			const box = canvas.getBoundingClientRect();
			return { x: r.left - box.left + canvas.scrollLeft, y: r.top - box.top, w: r.width, h: r.height };
		};

		/** Hover behaviour for the current drawing (it is replaced on every toggle). */
		const bind = () => {
			const svg = holder.querySelector<SVGSVGElement>("svg");
			if (!svg) return;
			const nodes = [...svg.querySelectorAll<SVGGElement>(".mg-node")];
			const edges = [...svg.querySelectorAll<SVGGElement>(".mg-edge")];
			/** Light the given wires and the cards they join; fade the rest. Nothing given: reset. */
			const light = (lit: SVGGElement[], extra: string[] = []) => {
				const near = new Set(extra);
				for (const e of edges) {
					const on = lit.includes(e);
					e.classList.toggle("lit", on);
					if (on) near.add(e.dataset.from ?? "").add(e.dataset.to ?? "");
				}
				for (const n of nodes) n.classList.toggle("near", near.has(n.dataset.id ?? ""));
				canvas.classList.toggle("focused", near.size > 0);
			};
			const reset = () => {
				hideCards();
				light([]);
			};
			for (const n of nodes) {
				const id = n.dataset.id ?? "";
				const card = fig.querySelector<HTMLElement>(`.mg-card[data-node="${CSS.escape(id)}"]`);
				const show = () => {
					reset();
					light(
						edges.filter((e) => e.dataset.from === id || e.dataset.to === id),
						[id],
					);
					if (!card) return;
					card.hidden = false;
					const b = local(n.getBoundingClientRect());
					put(card, b.x + b.w / 2 - card.offsetWidth / 2, b.y + b.h + 8, b.y - 8);
				};
				n.addEventListener("pointerenter", show);
				n.addEventListener("focus", show);
				n.addEventListener("pointerleave", reset);
				n.addEventListener("blur", reset);
			}
			for (const e of edges) {
				const card = fig.querySelector<HTMLElement>(`.mg-card[data-edge="${e.dataset.i}"]`);
				const hit = e.querySelector(".mg-hit");
				if (!card || !hit) continue;
				const move = (ev: Event) => {
					const p = ev as PointerEvent;
					const box = canvas.getBoundingClientRect();
					put(card, p.clientX - box.left + canvas.scrollLeft + 14, p.clientY - box.top + 14, p.clientY - box.top - 14);
				};
				hit.addEventListener("pointerenter", (ev) => {
					reset();
					light([e]);
					card.hidden = false;
					move(ev);
				});
				hit.addEventListener("pointermove", move);
				hit.addEventListener("pointerleave", reset);
			}
			for (const t of svg.querySelectorAll<SVGGElement>(".mg-toggle")) {
				const box = t.dataset.box ?? "";
				const flip = () => {
					if (collapsed.has(box)) collapsed.delete(box);
					else collapsed.add(box);
					redraw(box);
				};
				t.addEventListener("click", flip);
				t.addEventListener("keydown", (ev) => {
					if (ev.key === "Enter" || ev.key === " ") {
						ev.preventDefault();
						flip();
					}
				});
			}
		};
		/** Lay out and draw the graph again, then give the toggled box's button the focus back. */
		const redraw = (focus: string) => {
			hideCards();
			canvas.classList.remove("focused");
			holder.innerHTML = renderSvg(layoutModule(collapse(data.graph, collapsed)), data.title);
			bind();
			holder.querySelector<SVGGElement>(`.mg-toggle[data-box="${CSS.escape(focus)}"]`)?.focus();
		};
		bind();
	}
</script>

<style>
	.mg {
		--mg-card: var(--bg);
		--mg-line: color-mix(in oklch, var(--muted) 55%, var(--bg));
		--mg-border: var(--faint);
		--mg-text: var(--text);
		--mg-muted: var(--muted);
		--mg-lit: var(--accent);
		/* Icon colours: ops, leaf modules, collectives, sparkles. */
		--mg-fn: #7c5cd6;
		--mg-hex: #b04fc4;
		--mg-x: #c27a12;
		--mg-spark: #4a7fe0;
		/* Row tints (row_tones 0–7). */
		--t0: #2a78d6;
		--t1: #eb6834;
		--t2: #1baf7a;
		--t3: #eda100;
		--t4: #e87ba4;
		--t5: #008300;
		--t6: #4a3aa7;
		--t7: #e34948;
		margin: 1.75rem 0;
		font-family: var(--sans);
	}
	@media (prefers-color-scheme: dark) {
		.mg {
			--mg-fn: #9d86f0;
			--mg-hex: #d083e0;
			--mg-x: #e3a04a;
			--mg-spark: #6d9cf5;
			--t0: #3987e5;
			--t1: #d95926;
			--t2: #199e70;
			--t3: #c98500;
			--t4: #d55181;
			--t5: #2ea043;
			--t6: #9085e9;
			--t7: #e66767;
		}
	}
	@media (min-width: 1081px) {
		.mg.wide {
			width: calc(100% + var(--gap) + var(--note));
		}
	}
	.mg-title {
		margin-bottom: 0.4rem;
		font-size: 0.9rem;
		font-weight: 600;
		text-align: center;
	}
	.mg-canvas {
		position: relative;
		overflow-x: auto;
	}
	.mg-canvas :global(svg) {
		display: block;
		max-width: 100%;
		height: auto;
		margin: 0 auto;
		font-family: var(--mono);
	}

	/* Module boxes. */
	.mg-canvas :global(.mg-box) {
		fill: color-mix(in oklch, var(--surface) 45%, transparent);
		stroke: var(--mg-border);
		stroke-width: 1.1;
	}
	.mg-canvas :global(.mg-box[data-depth="0"]) {
		fill: transparent;
	}
	.mg-canvas :global(.mg-box.dashed) {
		fill: transparent;
		stroke: var(--mg-line);
		stroke-dasharray: 5 4;
	}
	.mg-canvas :global(.mg-box-t) {
		font-size: 11px;
		fill: var(--mg-muted);
		stroke: var(--bg);
		stroke-width: 4px;
		stroke-linejoin: round;
		paint-order: stroke;
		pointer-events: none;
	}

	/* Wires. */
	.mg-canvas :global(.mg-wire) {
		fill: none;
		stroke: var(--mg-line);
		stroke-width: 1.1;
		transition: stroke 0.15s;
	}
	.mg-canvas :global(.mg-arrow) {
		fill: var(--mg-line);
		transition: fill 0.15s;
	}
	.mg-canvas :global(.mg-hit) {
		fill: none;
		stroke: transparent;
		stroke-width: 12;
		pointer-events: stroke;
		cursor: help;
	}
	.mg-canvas :global(.mg-edge.lit .mg-wire) {
		stroke: var(--mg-lit);
		stroke-width: 1.6;
	}
	.mg-canvas :global(.mg-edge.lit .mg-arrow) {
		fill: var(--mg-lit);
	}

	/* Cards. */
	.mg-canvas :global(.mg-node) {
		cursor: default;
		outline: none;
	}
	.mg-canvas :global(.mg-cardbox) {
		fill: var(--mg-card);
		stroke: var(--mg-border);
		stroke-width: 1.1;
	}
	.mg-canvas :global(.mg-t) {
		font-size: 13px;
		fill: var(--mg-text);
	}
	.mg-canvas :global(.mg-s) {
		font-size: 11px;
		fill: var(--mg-muted);
	}
	.mg-canvas :global(.mg-node.near .mg-cardbox) {
		stroke: var(--mg-lit);
	}
	.mg-canvas :global(.mg-node:focus-visible .mg-cardbox) {
		stroke: var(--mg-lit);
		stroke-dasharray: 3 2;
	}
	.mg-canvas :global(.mg-node),
	.mg-canvas :global(.mg-edge) {
		transition: opacity 0.15s;
	}
	.mg-canvas:global(.focused) :global(.mg-node:not(.near)),
	.mg-canvas:global(.focused) :global(.mg-edge:not(.lit)) {
		opacity: 0.35;
	}

	/* Collapse / expand buttons. */
	.mg-canvas :global(.mg-toggle) {
		cursor: pointer;
		outline: none;
	}
	.mg-canvas :global(.mg-toggle rect) {
		fill: var(--mg-card);
		stroke: var(--mg-border);
		stroke-width: 1.1;
	}
	.mg-canvas :global(.mg-toggle path) {
		fill: none;
		stroke: var(--mg-muted);
		stroke-width: 1.5;
		stroke-linecap: round;
	}
	.mg-canvas :global(.mg-toggle:hover rect),
	.mg-canvas :global(.mg-toggle:focus-visible rect) {
		stroke: var(--mg-lit);
	}
	.mg-canvas :global(.mg-toggle:hover path),
	.mg-canvas :global(.mg-toggle:focus-visible path) {
		stroke: var(--mg-lit);
	}
	.mg-canvas :global(.mg-node.collapsed .mg-cardbox) {
		stroke-dasharray: none;
		stroke-width: 1.6;
	}

	/* Icons. */
	.mg-canvas :global(.mg-ic-fn) {
		fill: none;
		stroke: var(--mg-fn);
		stroke-width: 1.3;
	}
	.mg-canvas :global(.mg-ic-fn-t) {
		fill: var(--mg-fn);
	}
	.mg-canvas :global(.mg-ic-hex) {
		fill: none;
		stroke: var(--mg-hex);
		stroke-width: 1.3;
	}
	.mg-canvas :global(.mg-ic-hex-d) {
		fill: var(--mg-hex);
	}
	.mg-canvas :global(.mg-ic-x) {
		fill: none;
		stroke: var(--mg-x);
		stroke-width: 1.3;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.mg-canvas :global(.mg-ic-line) {
		fill: none;
		stroke: var(--mg-muted);
		stroke-width: 1.4;
	}
	.mg-canvas :global(.mg-ic-solid) {
		fill: var(--mg-muted);
	}
	.mg-canvas :global(.mg-ic-spark) {
		fill: var(--mg-spark);
	}
	.mg-canvas :global(.mg-ic-dot) {
		fill: var(--mg-border);
	}

	/* Hover cards: a node's equation, an edge's tensor. */
	.mg-card {
		position: absolute;
		z-index: 5;
		width: max-content;
		max-width: min(30rem, 100%);
		padding: 0.5rem 0.65rem;
		border: 1px solid var(--faint);
		border-radius: 8px;
		background: var(--bg);
		box-shadow: 0 6px 20px rgb(0 0 0 / 0.18);
		font-size: 0.72rem;
		pointer-events: none;
	}
	.mg-card[hidden] {
		display: none;
	}
	.card-title {
		margin: 0;
		font-size: 0.8rem;
		font-weight: 700;
	}
	.card-note {
		margin: 0.35rem 0 0;
		color: var(--muted);
		line-height: 1.4;
	}
	.eq .katex-line {
		margin: 0.15rem 0;
		overflow-x: auto;
		font-size: 0.85rem;
	}
	.eq .katex-line :global(.katex-display) {
		margin: 0.25rem 0;
	}
	.mx {
		width: auto;
		margin: 0.2rem 0 0;
		border-collapse: collapse;
		font-family: var(--mono);
		font-size: 0.68rem;
	}
	.mx th,
	.mx td {
		padding: 0.08rem 0.35rem;
		border: 0;
		white-space: nowrap;
		text-align: right;
	}
	.mx .ax-col {
		font-family: var(--sans);
		font-weight: 600;
		color: var(--muted);
		text-align: center;
	}
	.mx .idx-col {
		font-weight: 400;
		color: var(--muted);
		border-bottom: 1px solid var(--muted);
	}
	.mx .ax-row {
		padding: 0 0.2rem 0 0;
		vertical-align: middle;
	}
	.mx .ax-row span {
		display: inline-block;
		writing-mode: vertical-rl;
		transform: rotate(180deg);
		font-family: var(--sans);
		font-weight: 600;
		color: var(--muted);
	}
	.mx .idx-row {
		font-weight: 400;
		color: var(--muted);
	}
	.mx td {
		color: var(--muted);
	}
	.mx td.first {
		border-left: 1px solid var(--muted);
	}
	.mx td.nz {
		color: var(--text);
	}
	.mx .t0 { --c: var(--t0); }
	.mx .t1 { --c: var(--t1); }
	.mx .t2 { --c: var(--t2); }
	.mx .t3 { --c: var(--t3); }
	.mx .t4 { --c: var(--t4); }
	.mx .t5 { --c: var(--t5); }
	.mx .t6 { --c: var(--t6); }
	.mx .t7 { --c: var(--t7); }
	.mx tr.tone td {
		background: color-mix(in srgb, var(--c) 14%, transparent);
	}
	.mx-card .shape-line {
		margin: 0.35rem 0 0;
		text-align: center;
		font-family: var(--mono);
		font-size: 0.68rem;
	}
	.mx-card .sym {
		color: var(--text);
	}
	.mx-card .concrete {
		color: var(--muted);
	}
</style>
