---
// A PyTorch module drawn as its dataflow graph: every op (and leaf module, such as a Linear) is a
// card, every module with operations a box around its cards, nested as the modules are (function
// calls in dashed boxes), and every tensor a thin right-angled wire with an arrowhead, from the
// op that produced it to each op that reads it. Cards carry an icon (an op, a leaf module, a
// collective, an input or an output), a monospace title and the PyTorch call as a muted subtitle.
// Hovering a card lights its wires and neighbours and shows its equation, its input and output
// shapes and its weights (if the spec lists any: a value histogram, the singular values and the
// numerical, effective and stable ranks, which show rank collapse); hovering a wire shows its
// tensor as a matrix with axis titles and shape; hovering the label of a box with weights shows
// them. The names in symbolic shapes are explained from the root's `symbols`. Clicking a card,
// wire or box label pins its hover card (a second click, a click elsewhere or Escape unpins it). Every box has a − button that collapses it
// into one card, which gets a + button to expand it again; `collapsed` lists the boxes (dotted
// names, "" for the root) that start collapsed. The input is a nested JSON module
// (moduleGraph.ts describes the format), lowered to a flat graph that moduleLayout.ts lays out
// and moduleRender.ts draws, at build time and again in the browser after a toggle.
// Self-contained: it uses no other component. The drawing shrinks to 75% at most, then scrolls.
// Usage in .mdx:
//   import spec from "../../utils/distributed/graph/megatronMoe.json";
//   <ModuleGraph spec={spec} wide collapsed={["local_experts.1"]} />
import katex from "katex";
import {
	type ModuleSpec,
	type TensorValue,
	type WeightSpec,
	collapse,
	lower,
	moduleLabel,
} from "./moduleGraph";
import { layoutModule } from "./moduleLayout";
import { renderSvg } from "./moduleRender";
import { weightHtml, weightStats } from "./weightStats";

interface Props {
	spec: ModuleSpec;
	/** Extend into the margin-note column on wide screens. */
	wide?: boolean;
	title?: string;
	/** Boxes (dotted module names, "" for the root) that start collapsed. */
	collapsed?: string[];
}

const { spec, wide = false, title, collapsed = [] } = Astro.props;
const graph = lower(spec);
for (const c of collapsed)
	if (!(c in graph.modules))
		throw new Error(
			`ModuleGraph: collapsed "${c}" is not a module or function with operations`,
		);
const svg = renderSvg(layoutModule(collapse(graph, collapsed)), title);
// What the browser needs to redraw after a toggle: the graph without equations, tensor values or
// weights (a module keeps an empty `weights` as the mark that its label has a card).
const clientGraph = {
	nodes: graph.nodes.map(({ equation, outputs, weights, ...n }) => n),
	edges: graph.edges.map((e) => ({
		from: e.from,
		to: e.to,
		index: e.index,
		tensor: { name: e.tensor.name, shape: [] },
	})),
	modules: Object.fromEntries(
		Object.entries(graph.modules).map(([k, m]) => [
			k,
			{ ...m, weights: m.weights ? {} : undefined },
		]),
	),
};
const data = JSON.stringify({ graph: clientGraph, collapsed, title }).replace(
	/</g,
	"\\u003c",
);
const tex = (l: string) =>
	katex.renderToString(l, {
		displayMode: true,
		throwOnError: false,
		output: "html",
	});
const isZero = (v: string) => /^-?0(\.0+)?$/.test(v);
const symbols = spec.symbols ?? {};
/** The names in these shapes that `symbols` explains, in order of first use. */
const usedSymbols = (ts: TensorValue[]) =>
	[
		...new Set(
			ts.flatMap((t) => t.symbolic_shape?.match(/[A-Za-z_]\w*/g) ?? []),
		),
	].filter((w) => Object.hasOwn(symbols, w));
const weightsHtml = (ws?: Record<string, WeightSpec>) =>
	Object.entries(ws ?? {})
		.map(([k, w]) => weightHtml(k, weightStats(w)))
		.join("");
const unique = <T extends { name: string }>(ts: T[]) =>
	ts.filter((t, i) => ts.findIndex((u) => u.name === t.name) === i);
/** A card per node: its equation, the tensors it reads and writes, its weights. */
const nodeCards = graph.nodes.map((n) => {
	const ins = unique(
		graph.edges.filter((e) => e.to === n.id).map((e) => e.tensor),
	);
	const outs = unique(n.outputs ?? []);
	return {
		n,
		ins,
		outs,
		syms: usedSymbols([...ins, ...outs]),
		weights: weightsHtml(n.weights),
	};
});
const boxCards = Object.entries(graph.modules)
	.filter(([, m]) => m.weights)
	.map(([id, m]) => ({
		id,
		label: moduleLabel(id, m),
		weights: weightsHtml(m.weights),
	}));
---

<figure class:list={["mg", { wide }]}>
	{title && <figcaption class="mg-title">{title}</figcaption>}
	<div class="mg-canvas">
		<div class="mg-svg" set:html={svg} />
		<script is:inline type="application/json" class="mg-data" set:html={data} />
	</div>
	<!-- Hover cards sit outside the scrolling canvas, so a tall card is not clipped by it. -->
	<div class="mg-cards">
		{
			nodeCards.map(({ n, ins, outs, syms, weights }) => (
				<div class="mg-card eq" data-node={n.id} hidden>
					<p class="card-title">{n.equation?.title ?? <code>{n.label}</code>}</p>
					{n.equation?.latex.map((l) => <div class="katex-line" set:html={tex(l)} />)}
					{n.equation?.note && <p class="card-note">{n.equation.note}</p>}
					{ins.length + outs.length > 0 && (
						<table class="io">
							<tbody>
								{[...ins.map((t) => ["in", t] as const), ...outs.map((t) => ["out", t] as const)].map(([dir, t]) => (
									<tr>
										<th>{dir}</th>
										<td><code>{t.name}</code></td>
										<td class="sym">{t.symbolic_shape}</td>
										<td class="concrete">({t.shape.join(", ")})</td>
									</tr>
								))}
							</tbody>
						</table>
					)}
					{syms.length > 0 && (
						<dl class="syms">
							{syms.map((w) => (
								<>
									<dt>{w}</dt>
									<dd>{symbols[w]}</dd>
								</>
							))}
						</dl>
					)}
					{weights && <Fragment set:html={weights} />}
				</div>
			))
		}
		{
			boxCards.map((b) => (
				<div class="mg-card eq" data-module={b.id} hidden>
					<p class="card-title"><code>{b.label}</code></p>
					<Fragment set:html={b.weights} />
				</div>
			))
		}
		{
			graph.edges.map((e) => {
				const t = e.tensor;
				const rows = t.values ?? [];
				const cols = t.col_labels ?? rows[0]?.map((_, j) => `${j}`) ?? [];
				return (
					<div class="mg-card mx-card" data-edge={e.index} hidden>
						<p class="card-title">
							<code>{t.name}</code>
						</p>
						{rows.length > 0 && (
							<table class="mx">
								<tbody>
									<tr>
										<td colspan="2" />
										<th class="ax-col" colspan={cols.length}>
											{t.axes?.[1]}
										</th>
									</tr>
									<tr>
										<td colspan="2" />
										{cols.map((c) => (
											<th class="idx-col">{c}</th>
										))}
									</tr>
									{rows.map((row, r) => (
										<tr class={t.row_tones?.[r] == null ? "" : `tone t${t.row_tones[r]}`}>
											{r === 0 && (
												<th class="ax-row" rowspan={rows.length}>
													<span>{t.axes?.[0]}</span>
												</th>
											)}
											<th class="idx-row">{t.row_labels?.[r] ?? r}</th>
											{row.map((v, j) => (
												<td class:list={{ first: j === 0, nz: !isZero(v) }}>{v}</td>
											))}
										</tr>
									))}
								</tbody>
							</table>
						)}
						<p class="shape-line">
							{t.symbolic_shape && <span class="sym">{t.symbolic_shape} = </span>}
							<span class="concrete">({t.shape.join(", ")})</span>
						</p>
						{usedSymbols([t]).length > 0 && (
							<dl class="syms">
								{usedSymbols([t]).map((w) => (
									<>
										<dt>{w}</dt>
										<dd>{symbols[w]}</dd>
									</>
								))}
							</dl>
						)}
						{t.note && <p class="card-note">{t.note}</p>}
					</div>
				);
			})
		}
	</div>
</figure>

<script>
	import { type LoweredGraph, collapse } from "./moduleGraph";
	import { layoutModule } from "./moduleLayout";
	import { renderSvg } from "./moduleRender";

	for (const fig of document.querySelectorAll<HTMLElement>(".mg")) {
		const canvas = fig.querySelector<HTMLElement>(".mg-canvas");
		const holder = fig.querySelector<HTMLElement>(".mg-svg");
		const dataEl = fig.querySelector<HTMLScriptElement>(".mg-data");
		if (!canvas || !holder || !dataEl) continue;
		const data: { graph: LoweredGraph; collapsed: string[]; title?: string } = JSON.parse(dataEl.textContent ?? "{}");
		const collapsed = new Set(data.collapsed);
		const cards = [...fig.querySelectorAll<HTMLElement>(".mg-card")];
		const hideCards = () => {
			for (const c of cards) c.hidden = true;
		};
		/**
		 * Places a card (figure coordinates) at (x, y), within the figure's width; above `above`
		 * instead when it would run past the bottom of the window and fits above.
		 */
		const put = (card: HTMLElement, x: number, y: number, above: number) => {
			const box = fig.getBoundingClientRect();
			const h = card.offsetHeight;
			const left = Math.min(Math.max(0, x), Math.max(0, fig.clientWidth - card.offsetWidth));
			const top = box.top + y + h > window.innerHeight && box.top + above - h > 0 ? above - h : y;
			card.style.left = `${left}px`;
			card.style.top = `${top}px`;
		};
		const local = (r: DOMRect) => {
			const box = fig.getBoundingClientRect();
			return { x: r.left - box.left, y: r.top - box.top, w: r.width, h: r.height };
		};
		/**
		 * A clicked node, wire or box label pins its card: hovering then changes nothing until the
		 * same element is clicked again, the reader clicks elsewhere, or presses Escape.
		 */
		let pinned: Element | null = null;
		let clear = () => {};
		const unpin = () => {
			pinned = null;
			for (const c of cards) c.classList.remove("pinned");
			clear();
		};
		document.addEventListener("click", (ev) => {
			const t = ev.target as Element | null;
			if (pinned && !(t && fig.contains(t) && t.closest(".mg-node, .mg-hit, .mg-box-hit, .mg-card"))) unpin();
		});
		document.addEventListener("keydown", (ev) => {
			if (pinned && ev.key === "Escape") unpin();
		});

		/** Hover behaviour for the current drawing (it is replaced on every toggle). */
		const bind = () => {
			const svg = holder.querySelector<SVGSVGElement>("svg");
			if (!svg) return;
			const nodes = [...svg.querySelectorAll<SVGGElement>(".mg-node")];
			const edges = [...svg.querySelectorAll<SVGGElement>(".mg-edge")];
			/** Light the given wires and the cards they join; fade the rest. Nothing given: reset. */
			const light = (lit: SVGGElement[], extra: string[] = []) => {
				const near = new Set(extra);
				for (const e of edges) {
					const on = lit.includes(e);
					e.classList.toggle("lit", on);
					if (on) near.add(e.dataset.from ?? "").add(e.dataset.to ?? "");
				}
				for (const n of nodes) n.classList.toggle("near", near.has(n.dataset.id ?? ""));
				canvas.classList.toggle("focused", near.size > 0);
			};
			const reset = () => {
				hideCards();
				light([]);
			};
			clear = reset;
			/** Hover shows (and leaving hides) a card unless one is pinned; a click pins or unpins. */
			const pinnable = (el: Element, card: HTMLElement | null, show: (ev?: Event) => void) => {
				el.addEventListener("pointerenter", (ev) => {
					if (!pinned) show(ev);
				});
				el.addEventListener("pointerleave", () => {
					if (!pinned) reset();
				});
				const click = (ev?: Event) => {
					if (pinned === el) return unpin();
					unpin();
					show(ev);
					pinned = el;
					card?.classList.add("pinned");
				};
				el.addEventListener("click", click);
				el.addEventListener("keydown", (ev) => {
					const k = (ev as KeyboardEvent).key;
					if (k === "Enter" || k === " ") {
						ev.preventDefault();
						click();
					}
				});
			};
			for (const n of nodes) {
				const id = n.dataset.id ?? "";
				// A collapsed box's card shows the module's weights, if it lists any.
				const card = fig.querySelector<HTMLElement>(
					n.classList.contains("collapsed") ? `.mg-card[data-module="${CSS.escape(id)}"]` : `.mg-card[data-node="${CSS.escape(id)}"]`,
				);
				const show = () => {
					reset();
					light(
						edges.filter((e) => e.dataset.from === id || e.dataset.to === id),
						[id],
					);
					if (!card) return;
					card.hidden = false;
					const b = local(n.getBoundingClientRect());
					put(card, b.x + b.w / 2 - card.offsetWidth / 2, b.y + b.h + 8, b.y - 8);
				};
				pinnable(n, card, show);
				n.addEventListener("focus", () => {
					if (!pinned) show();
				});
				n.addEventListener("blur", () => {
					if (!pinned) reset();
				});
			}
			for (const e of edges) {
				const card = fig.querySelector<HTMLElement>(`.mg-card[data-edge="${e.dataset.i}"]`);
				const hit = e.querySelector(".mg-hit");
				if (!card || !hit) continue;
				const move = (ev?: Event) => {
					const p = ev as PointerEvent | undefined;
					const box = fig.getBoundingClientRect();
					if (!p) return put(card, 0, local(hit.getBoundingClientRect()).y, 0);
					put(card, p.clientX - box.left + 14, p.clientY - box.top + 14, p.clientY - box.top - 14);
				};
				pinnable(hit, card, (ev) => {
					reset();
					light([e]);
					card.hidden = false;
					move(ev);
				});
				hit.addEventListener("pointermove", (ev) => {
					if (!pinned) move(ev);
				});
			}
			for (const hit of svg.querySelectorAll<SVGRectElement>(".mg-box-hit")) {
				const card = fig.querySelector<HTMLElement>(`.mg-card[data-module="${CSS.escape(hit.dataset.box ?? "")}"]`);
				if (!card) continue;
				const show = () => {
					reset();
					card.hidden = false;
					const b = local(hit.getBoundingClientRect());
					put(card, b.x, b.y + b.h + 6, b.y - 6);
				};
				pinnable(hit, card, show);
				hit.addEventListener("focus", () => {
					if (!pinned) show();
				});
				hit.addEventListener("blur", () => {
					if (!pinned) reset();
				});
			}
			for (const t of svg.querySelectorAll<SVGGElement>(".mg-toggle")) {
				const box = t.dataset.box ?? "";
				const flip = () => {
					if (collapsed.has(box)) collapsed.delete(box);
					else collapsed.add(box);
					redraw(box);
				};
				t.addEventListener("click", flip);
				t.addEventListener("keydown", (ev) => {
					if (ev.key === "Enter" || ev.key === " ") {
						ev.preventDefault();
						flip();
					}
				});
			}
		};
		/** Lay out and draw the graph again, then give the toggled box's button the focus back. */
		const redraw = (focus: string) => {
			pinned = null;
			for (const c of cards) c.classList.remove("pinned");
			hideCards();
			canvas.classList.remove("focused");
			holder.innerHTML = renderSvg(layoutModule(collapse(data.graph, collapsed)), data.title);
			bind();
			holder.querySelector<SVGGElement>(`.mg-toggle[data-box="${CSS.escape(focus)}"]`)?.focus();
		};
		bind();
	}
</script>

<style>
	.mg {
		--mg-card: var(--bg);
		--mg-line: color-mix(in oklch, var(--muted) 55%, var(--bg));
		--mg-border: var(--faint);
		--mg-text: var(--text);
		--mg-muted: var(--muted);
		--mg-lit: var(--accent);
		--mg-grid: color-mix(in oklch, var(--muted) 20%, transparent);
		--mg-shadow: rgb(40 36 20 / 0.07);
		/* Icon colours: ops, leaf modules, collectives, sparkles. */
		--mg-fn: #7c5cd6;
		--mg-hex: #b04fc4;
		--mg-x: #c27a12;
		--mg-spark: #4a7fe0;
		/* Row tints (row_tones 0–7). */
		--t0: #2a78d6;
		--t1: #eb6834;
		--t2: #1baf7a;
		--t3: #eda100;
		--t4: #e87ba4;
		--t5: #008300;
		--t6: #4a3aa7;
		--t7: #e34948;
		position: relative;
		margin: 1.75rem 0;
		font-family: var(--sans);
	}
	@media (prefers-color-scheme: dark) {
		.mg {
			--mg-shadow: rgb(0 0 0 / 0.35);
			--mg-fn: #9d86f0;
			--mg-hex: #d083e0;
			--mg-x: #e3a04a;
			--mg-spark: #6d9cf5;
			--t0: #3987e5;
			--t1: #d95926;
			--t2: #199e70;
			--t3: #c98500;
			--t4: #d55181;
			--t5: #2ea043;
			--t6: #9085e9;
			--t7: #e66767;
		}
	}
	@media (min-width: 1081px) {
		.mg.wide {
			width: calc(100% + var(--gap) + var(--note));
		}
	}
	.mg-title {
		margin-bottom: 0.4rem;
		font-size: 0.9rem;
		font-weight: 600;
		text-align: center;
	}
	/* The drawing sits on a framed panel with a faint dot grid. */
	.mg-canvas {
		position: relative;
		overflow-x: auto;
		padding: 1.25rem 1rem;
		border: 1px solid var(--faint);
		border-radius: 14px;
		background:
			radial-gradient(circle, var(--mg-grid) 1px, transparent 1.3px) 0 0 / 18px 18px,
			var(--bg);
	}
	.mg-canvas :global(svg) {
		display: block;
		max-width: 100%;
		height: auto;
		margin: 0 auto;
		overflow: visible;
		font-family: var(--mono);
	}

	/* Module boxes: tinted more the deeper they nest; function calls dashed. */
	.mg-canvas :global(.mg-box) {
		fill: color-mix(in oklch, var(--mg-hex) 3%, color-mix(in oklch, var(--surface) 55%, transparent));
		stroke: color-mix(in oklch, var(--mg-hex) 22%, var(--mg-border));
		stroke-width: 1.1;
	}
	.mg-canvas :global(.mg-box[data-depth="0"]) {
		fill: color-mix(in oklch, var(--surface) 30%, transparent);
	}
	.mg-canvas :global(.mg-box[data-depth="2"]),
	.mg-canvas :global(.mg-box[data-depth="3"]) {
		fill: color-mix(in oklch, var(--mg-hex) 5%, var(--surface));
	}
	.mg-canvas :global(.mg-box.dashed) {
		fill: color-mix(in oklch, var(--mg-fn) 3%, transparent);
		stroke: color-mix(in oklch, var(--mg-fn) 45%, var(--mg-border));
		stroke-dasharray: 5 4;
		stroke-linecap: round;
	}
	.mg-canvas :global(.mg-chip) {
		fill: var(--mg-card);
		stroke: color-mix(in oklch, var(--mg-hex) 25%, var(--mg-border));
		stroke-width: 1;
	}
	.mg-canvas :global(.mg-chip.fn) {
		stroke: color-mix(in oklch, var(--mg-fn) 40%, var(--mg-border));
	}
	.mg-canvas :global(.mg-box-t) {
		font-size: 11px;
		fill: var(--mg-muted);
		pointer-events: none;
	}
	.mg-canvas :global(.mg-box-t.has-card) {
		fill: var(--mg-text);
		text-decoration: underline dotted;
	}
	.mg-canvas :global(.mg-box-hit) {
		fill: transparent;
		cursor: pointer;
		outline: none;
	}

	/* Wires: rounded corners, dots where bundles split or join, a flow along lit wires. */
	.mg-canvas :global(.mg-wire) {
		fill: none;
		stroke: var(--mg-line);
		stroke-width: 1.25;
		stroke-linejoin: round;
		transition: stroke 0.15s;
	}
	.mg-canvas :global(.mg-arrow) {
		fill: var(--mg-line);
		stroke: var(--mg-line);
		stroke-width: 1;
		stroke-linejoin: round;
		transition: fill 0.15s;
	}
	.mg-canvas :global(.mg-junction) {
		fill: var(--mg-line);
		stroke: var(--bg);
		stroke-width: 1.5;
		pointer-events: none;
		transition: opacity 0.15s;
	}
	.mg-canvas:global(.focused) :global(.mg-junction) {
		opacity: 0.3;
	}
	.mg-canvas :global(.mg-flow) {
		display: none;
		fill: none;
		stroke: var(--mg-card);
		stroke-width: 1.4;
		stroke-linecap: round;
		stroke-dasharray: 2 9;
		pointer-events: none;
	}
	.mg-canvas :global(.mg-hit) {
		fill: none;
		stroke: transparent;
		stroke-width: 12;
		pointer-events: stroke;
		cursor: pointer;
	}
	.mg-canvas :global(.mg-edge.lit .mg-wire) {
		stroke: var(--mg-lit);
		stroke-width: 2.4;
		filter: drop-shadow(0 0 3px color-mix(in oklch, var(--mg-lit) 45%, transparent));
	}
	.mg-canvas :global(.mg-edge.lit .mg-flow) {
		display: inline;
		animation: mg-flow 0.9s linear infinite;
	}
	.mg-canvas :global(.mg-edge.lit .mg-arrow) {
		fill: var(--mg-lit);
		stroke: var(--mg-lit);
	}
	@keyframes mg-flow {
		from {
			stroke-dashoffset: 11;
		}
		to {
			stroke-dashoffset: 0;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.mg-canvas :global(.mg-edge.lit .mg-flow) {
			display: none;
		}
	}

	/* Cards: a colour per kind (ops, leaf modules, collectives, inputs and outputs). */
	.mg-canvas :global(.mg-node) {
		--k: var(--mg-fn);
		cursor: pointer;
		outline: none;
	}
	.mg-canvas :global(.mg-node.k-module) {
		--k: var(--mg-hex);
	}
	.mg-canvas :global(.mg-node.k-collective) {
		--k: var(--mg-x);
