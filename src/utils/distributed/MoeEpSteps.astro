---
import ParallelGraph from "./ParallelGraph.astro";
// Step-through of one expert-parallel MoE layer (EP = 4, 8 experts, top-2, 8 tokens) as Megatron-LM,
// DeepSpeed, DeepSeek, vLLM or SGLang runs it; the flows are defined in epFlows.ts, the shared
// example in epDispatch.ts. The graph on top is a ParallelGraph drawn from the flow's spec
// (epSpecs.ts: operations, tensors, parallel config), so hovering an edge shows its tensor and
// hovering a node its equation; each step highlights the operations it runs. Below the graph,
// the code, with the line each step runs highlighted.
// Usage in .mdx:
//   <MoeEpSteps />
//   <MoeEpSteps flow="vllm" title="vLLM's default EP path" />
import { type FlowName, buildFlow } from "./epFlows";
import { flowSpec } from "./epSpecs";

interface Props {
	flow?: FlowName;
	title?: string;
}

const { flow: flowName = "megatron", title } = Astro.props;
const flow = buildFlow(flowName);
const { steps } = flow;
const data = JSON.stringify({
	steps: steps.map((s) => ({
		line: s.line,
		active: s.active,
	})),
});
---

<figure class="moe-ep" data-ep={data}>
	{title && <figcaption class="title">{title}</figcaption>}
	<ParallelGraph spec={flowSpec(flowName)} wide />
	<div class="controls">
		<div class="buttons">
			<button type="button" data-act="first" aria-label="First step">
				<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 3v10M13 3 6 8l7 5z"></path></svg>
			</button>
			<button type="button" data-act="prev" aria-label="Previous step">
				<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M11 3 4 8l7 5z"></path></svg>
			</button>
			<button type="button" data-act="play" class="play" aria-label="Play">
				<svg class="i-play" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 2.5v11L13.5 8z"></path></svg>
				<svg class="i-pause" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 3h3v10H4zM9 3h3v10H9z"></path></svg>
			</button>
			<button type="button" data-act="next" aria-label="Next step">
				<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3l7 5-7 5z"></path></svg>
			</button>
		</div>
		<div class="timeline" role="group" aria-label="Steps">
			{steps.map((s, i) => <button type="button" class="seg" data-i={i} aria-label={s.head} title={s.head} />)}
		</div>
		<span class="counter"></span>
	</div>
	<div class="narration" aria-live="polite">
		<p class="head"></p>
		<p class="body"></p>
	</div>
	<pre class="code" aria-label="MoE forward pass, condensed"><code>{flow.code.map((l, i) => <span class="ln" data-line={i}>{l}{"\n"}</span>)}</code></pre>
	<p class="source">{flow.source}</p>
	<div class="store" hidden>
		{steps.map((s) => <span data-head={s.head}>{s.body}</span>)}
	</div>
</figure>

<script>
	interface Data {
		steps: { line: number; active: string[] }[];
	}

	for (const fig of document.querySelectorAll<HTMLElement>(".moe-ep")) {
		const data: Data = JSON.parse(fig.dataset.ep ?? "{}");
		const svg = fig.querySelector<SVGSVGElement>(".pg svg");
		if (!svg) continue;
		const nodes = new Map<string, SVGGElement>();
		for (const n of svg.querySelectorAll<SVGGElement>(".node")) nodes.set(n.dataset.id ?? "", n);
		const lines = [...fig.querySelectorAll<HTMLElement>(".code .ln")];
		const segs = [...fig.querySelectorAll<HTMLButtonElement>(".seg")];
		const store = [...fig.querySelectorAll<HTMLElement>(".store span")];
		const head = fig.querySelector(".narration .head");
		const body = fig.querySelector(".narration .body");
		const counter = fig.querySelector(".counter");
		const play = fig.querySelector<HTMLButtonElement>("[data-act=play]");
		const last = data.steps.length - 1;
		let at = 0;
		let timer: number | undefined;

		const go = (i: number) => {
			at = Math.min(Math.max(0, i), last);
			const s = data.steps[at];
			const active = new Set(s.active);
			for (const [id, n] of nodes) n.classList.toggle("ep-active", active.has(id));
			lines.forEach((l, k) => l.classList.toggle("on", k === s.line));
			segs.forEach((b, k) => {
				b.classList.toggle("done", k <= at);
				b.setAttribute("aria-current", String(k === at));
			});
			if (head) head.textContent = store[at]?.dataset.head ?? "";
			if (body) body.textContent = store[at]?.textContent ?? "";
			if (counter) counter.textContent = `${at + 1} / ${last + 1}`;
		};
		const stop = () => {
			if (timer !== undefined) clearInterval(timer);
			timer = undefined;
			play?.classList.remove("playing");
			play?.setAttribute("aria-label", "Play");
		};
		const start = () => {
			if (at >= last) go(0);
			play?.classList.add("playing");
			play?.setAttribute("aria-label", "Pause");
			timer = window.setInterval(() => {
				if (at >= last) stop();
				else go(at + 1);
			}, 2600);
		};
		for (const b of fig.querySelectorAll<HTMLButtonElement>("[data-act]"))
			b.addEventListener("click", () => {
				const act = b.dataset.act;
				if (act === "play") return timer === undefined ? start() : stop();
				stop();
				if (act === "first") go(0);
				if (act === "prev") go(at - 1);
				if (act === "next") go(at + 1);
			});
		for (const b of segs)
			b.addEventListener("click", () => {
				stop();
				go(Number(b.dataset.i));
			});
		fig.addEventListener("keydown", (e) => {
			if (e.key !== "ArrowLeft" && e.key !== "ArrowRight") return;
			e.preventDefault();
			stop();
			go(at + (e.key === "ArrowRight" ? 1 : -1));
		});
		go(0);
	}
</script>

<style>
	.moe-ep {
		margin: 1.75rem 0;
		font-family: var(--sans);
	}
	.title {
		font-size: 0.9rem;
		font-weight: 600;
		text-align: center;
		margin-bottom: 0.4rem;
	}
	.moe-ep :global(.node.ep-active rect.body) {
		stroke: var(--text);
		stroke-width: 2.2;
		fill: color-mix(in oklch, var(--node-fill) 60%, var(--node-stroke));
	}
	/* On wide screens the title spans the graph, which also takes the margin-note column. */
	@media (min-width: 1081px) {
		.title {
			width: calc(100% + var(--gap) + var(--note));
		}
	}
	.moe-ep :global(.node.ep-active text.label) {
		font-weight: 700;
	}

	.controls {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-top: 0.5rem;
	}
	.buttons {
		display: flex;
		gap: 0.3rem;
	}
	.buttons button {
		display: grid;
		place-items: center;
		width: 2rem;
		height: 2rem;
		padding: 0;
		border: 1px solid var(--faint);
		border-radius: 8px;
		background: var(--bg);
		color: var(--text);
		cursor: pointer;
		transition: border-color 150ms ease;
	}
	.buttons button:hover {
		border-color: var(--accent);
	}
	.buttons svg {
		width: 0.8rem;
		height: 0.8rem;
		fill: currentColor;
		stroke: currentColor;
		stroke-width: 1.2;
		stroke-linejoin: round;
	}
	.buttons .play {
		width: 2.6rem;
		background: var(--accent);
		border-color: var(--accent);
		color: var(--bg);
	}
	.play .i-pause,
	.play.playing .i-play {
		display: none;
	}
	.play.playing .i-pause {
		display: block;
	}
	.timeline {
		flex: 1;
		display: flex;
		gap: 3px;
	}
	.seg {
		flex: 1;
		height: 0.55rem;
		padding: 0;
		border: 0;
		border-radius: 3px;
		background: var(--faint);
		cursor: pointer;
	}
	.seg.done {
		background: var(--accent);
	}
	.seg[aria-current="true"] {
		outline: 2px solid var(--text);
		outline-offset: 1px;
	}
	.counter {
		font-family: var(--mono);
		font-size: 0.75rem;
		color: var(--muted);
		min-width: 3.2rem;
		text-align: right;
	}
	.narration {
		margin-top: 0.5rem;
		font-size: 0.8rem;
		min-height: 4.6rem;
	}
	.narration p {
		margin: 0.15rem 0;
	}
	.narration .head {
		font-weight: 600;
	}
	.code {
		margin: 0.5rem 0 0;
		padding: 0.6rem 0;
		overflow-x: auto;
		font-size: 0.72rem;
		line-height: 1.55;
		border: 1px solid var(--faint);
		border-radius: 8px;
		background: var(--surface);
	}
	.code code {
		display: block;
		min-width: max-content;
	}
	.ln {
		display: block;
		padding: 0 0.8rem;
		border-left: 3px solid transparent;
		color: var(--muted);
		transition: background 200ms ease;
	}
	.ln.on {
		border-left-color: var(--accent);
		background: color-mix(in srgb, var(--accent) 16%, transparent);
		color: var(--text);
	}
	.source {
		margin: 0.3rem 0 0;
		font-size: 0.72rem;
		color: var(--muted);
	}
</style>
