---
import Legend from "./Legend.astro";
// Draws a neural network architecture (an NNGraph) as a diagram of layers and data flow: a
// static SVG laid out at build time. Nodes are coloured by kind (legend above the diagram),
// groups are drawn as boxes around their nodes, and hovering or focusing a node highlights its
// inputs and outputs. A node with a formula or weights also gets a card on hover/focus.
//
// The pieces:
//   nnLayout.ts       where everything goes (dagre)
//   Legend.astro      the legend of node kinds
//   NodeCard.astro    a node's hover card: formula, and a WeightPanel per weight tensor
//   nnInteraction.ts  highlighting and card placement in the browser
//   nnPalette.css     the colour of each node kind
//
// A node can reserve a "tray" (GraphNode.tray), an empty box below its text that other figures
// draw on top of; its position is in the node's data-tray attribute (see MoeEpSteps).
//
// Usage in .mdx:
//   <NeuralNetworkGraph graph={alexnet} title="AlexNet" />
import type { GraphNode, NNGraph } from "./NNGraph";
import NodeCard from "./NodeCard.astro";
import { kindClass } from "./kinds";
import { NN_ICONS } from "./nnIcons";
import { type Direction, type Look, layoutGraph } from "./nnLayout";
import "./nnPalette.css";

interface Props {
	graph: NNGraph;
	/** Flow direction: top-to-bottom (default), bottom-to-top, left-to-right, right-to-left. */
	direction?: Direction;
	title?: string;
	/** Show the legend of node kinds. */
	legend?: boolean;
	/** Keep the outputs of fan-out nodes in the order they were added, as inputs always are. */
	keepOutputOrder?: boolean;
	/** Gap between ranks of the layout, in px (default 34). */
	rankSep?: number;
	/**
	 * "flat" (default); "glass": gradient sheen, accent bar, soft shadow, square corners;
	 * "diagram": flat draw.io-style boxes coloured by kind, a large icon at the left, right-angled
	 * edges.
	 */
	look?: Look;
}

const {
	graph,
	direction = "TB",
	title,
	legend = true,
	keepOutputOrder = false,
	rankSep,
	look = "flat",
} = Astro.props;
const { nodes, edges, groups, box } = layoutGraph(graph, direction, {
	keepOutputOrder,
	rankSep,
	look,
});

const hasCard = (n: GraphNode) => !!(n.formula || n.weights);
/** What the browser's tooltip says for nodes without a card. */
const tooltip = (n: GraphNode) =>
	[n.label, n.detail, n.shape && `output ${n.shape}`]
		.filter(Boolean)
		.join(" · ");

// Ids are page-global; derive them from the graph (weights aside, which can be large) so two
// diagrams on one page don't share (and restyle) each other's arrowhead or cards.
const hash = [
	...JSON.stringify({
		...graph,
		nodes: graph.nodes.map(({ weights: _, ...n }) => n),
	}),
]
	.reduce((h, c) => (h * 31 + c.charCodeAt(0)) >>> 0, 7)
	.toString(36);
const arrowId = `nn-arrow-${hash}`;
const cardId = (id: string) => `nn-card-${hash}-${id}`;
---

<figure class:list={["nn-graph", `look-${look}`]}>
	{title && <figcaption class="title">{title}</figcaption>}
	{legend && <Legend nodes={graph.nodes} />}
	<div class="canvas">
		<svg
			viewBox={`${box.x} ${box.y} ${box.w} ${box.h}`}
			width={box.w}
			height={box.h}
			style={`min-width: ${Math.round(box.w * 0.75)}px`}
			role="img"
			aria-label={title ?? "Neural network architecture"}
		>
			<defs>
				<marker
					id={arrowId}
					viewBox="0 0 8 8"
					refX="8"
					refY="4"
					markerWidth="7"
					markerHeight="7"
					orient="auto-start-reverse"
				>
					<path class="arrowhead" d="M0,0.5 L8,4 L0,7.5 z" />
				</marker>
				<linearGradient id={`${arrowId}-sheen`} x1="0" y1="0" x2="0" y2="1">
					<stop offset="0" stop-color="#fff" stop-opacity="0.16" />
					<stop offset="0.55" stop-color="#fff" stop-opacity="0.02" />
					<stop offset="1" stop-color="#000" stop-opacity="0.06" />
				</linearGradient>
			</defs>

			{
				groups.map((b) => (
					<g class="group">
						<rect x={b.x} y={b.y} width={b.w} height={b.h} rx="10" />
						<text x={b.x + 10} y={b.y + 14}>
							{b.label}
						</text>
					</g>
				))
			}

			{
				edges.map((e) => (
					<g class="edge" data-from={e.from} data-to={e.to}>
						<path d={e.d} marker-end={`url(#${arrowId})`} />
						{e.labelAt && (
							<text class="edge-label" x={e.labelAt.x} y={e.labelAt.y} text-anchor={e.labelAt.anchor}>
								{e.label}
							</text>
						)}
					</g>
				))
			}

			{
				nodes.map((n) => (
					<g
						class={`node ${kindClass(n.kind)}`}
						data-id={n.id}
						data-tray={n.trayBox && [n.trayBox.x, n.trayBox.y, n.trayBox.w, n.trayBox.h].join(" ")}
						tabindex="0"
						aria-describedby={hasCard(n) ? cardId(n.id) : undefined}
					>
						{/* Nodes with a card use it instead of the browser's tooltip. */}
						{!hasCard(n) && <title>{tooltip(n)}</title>}
						{n.circle ? (
							<circle cx={n.x} cy={n.y} r={n.w / 2} />
						) : (
							<rect class="body" x={n.x - n.w / 2} y={n.y - n.h / 2} width={n.w} height={n.h} rx={look === "flat" ? 7 : 0} />
						)}
						{look === "glass" && !n.circle && (
							<>
								<rect class="sheen" x={n.x - n.w / 2} y={n.y - n.h / 2} width={n.w} height={n.h} style={`fill:url(#${arrowId}-sheen)`} />
								<path
									class="bar"
									d={`M${n.x - n.w / 2},${n.y - n.h / 2 + 1.25} H${n.x + n.w / 2}`}
								/>
							</>
						)}
						{n.iconAt && n.icon && (
							<g
								class="icon"
								data-cx={n.x}
								data-y={n.iconAt.y}
								data-size={n.iconAt.size}
								data-measure={look === "glass" ? "" : undefined}
								transform={`translate(${n.iconAt.x} ${n.iconAt.y}) scale(${n.iconAt.size / 24})`}
							>
								{look === "diagram" && n.kind === "other" && <rect class="icon-tile" x="-3" y="-3" width="30" height="30" />}
								<path d={NN_ICONS[n.icon]} />
							</g>
						)}
						{/* A dot in the corner marks nodes that have a card. */}
						{hasCard(n) && !n.circle && (
							<circle class="has-card" cx={n.x + n.w / 2 - 6} cy={n.y - n.h / 2 + 6} r="2.5" />
						)}
						{n.trayBox && (
							<rect class="tray" x={n.trayBox.x} y={n.trayBox.y} width={n.trayBox.w} height={n.trayBox.h} rx="4" />
						)}
						{n.lines.map((l) => (
							<text class={l.cls} x={l.x ?? n.x} y={l.y}>
								{l.text}
							</text>
						))}
					</g>
				))
			}
		</svg>
	</div>
	{graph.nodes.filter(hasCard).map((n) => <NodeCard node={n} id={cardId(n.id)} />)}
</figure>

<script>
	// The layout only estimates label widths; measure the real label and centre icon + label.
	for (const icon of document.querySelectorAll<SVGGElement>(".nn-graph .node .icon[data-measure]")) {
		const label = icon.parentElement?.querySelector<SVGTextElement>("text.label");
		if (!label) continue;
		const size = Number(icon.dataset.size);
		const gap = 5;
		const w = label.getComputedTextLength();
		if (!w) continue;
		const start = Number(icon.dataset.cx) - (size + gap + w) / 2;
		icon.setAttribute("transform", `translate(${start} ${icon.dataset.y}) scale(${size / 24})`);
		label.setAttribute("x", String(start + size + gap));
		label.style.textAnchor = "start";
	}
	import { attachInteractions } from "./nnInteraction";

	for (const fig of document.querySelectorAll<HTMLElement>(".nn-graph")) attachInteractions(fig);
</script>

<style>
	.nn-graph {
		margin: 1.75rem 0;
		/* The hover cards are positioned against the figure. */
		position: relative;
	}
	.title {
		font-family: var(--sans);
		font-size: 0.9rem;
		font-weight: 600;
		text-align: center;
		margin-bottom: 0.5rem;
	}
	/* Wide diagrams shrink to fit, but no further than 75% (min-width on the svg); past that
	   they scroll sideways rather than shrink the text into illegibility. */
	.canvas {
		overflow-x: auto;
	}
	svg {
		display: block;
		max-width: 100%;
		height: auto;
		margin: 0 auto;
		font-family: var(--sans);
	}

	.group rect {
		fill: color-mix(in oklch, var(--surface) 70%, transparent);
		stroke: var(--faint);
	}
	.group text {
		font-size: 11px;
		font-weight: 600;
		fill: var(--muted);
	}

	/* Looks restyle nodes and edges through these variables, so a figure's own rules (such as a
	   highlight) still win without a specificity fight. */
	.edge path {
		fill: none;
		stroke: var(--edge-stroke, var(--muted));
		stroke-width: var(--edge-sw, 1.3);
		stroke-opacity: var(--edge-opacity, 0.75);
	}
	.arrowhead {
		fill: var(--edge-stroke, var(--muted));
	}
	.edge-label {
		font-size: 10px;
		fill: var(--muted);
		/* A halo in the background colour keeps the label readable where it crosses a line. */
		paint-order: stroke;
		stroke: var(--bg);
		stroke-width: 3px;
	}

	.node {
		cursor: default;
		outline: none;
	}
	.node rect.body,
	.node > circle:not(.has-card) {
		fill: var(--node-fill, color-mix(in oklch, var(--c) 16%, var(--bg)));
		stroke: var(--node-stroke, color-mix(in oklch, var(--c) 75%, var(--bg)));
		stroke-width: var(--node-sw, 1.5);
		filter: var(--node-filter, none);
	}
	/* The tray only reserves space; it draws nothing. */
	.node .tray {
		fill: none;
		stroke: none;
	}
	.node .icon path {
		fill: none;
		stroke: var(--icon-stroke, var(--c));
		stroke-width: var(--icon-sw, 2);
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	/* The "glass" look: brighter tinted bodies, a sheen, an accent bar and a soft shadow. */
	.look-glass .node {
		--node-fill: color-mix(in oklch, var(--c) 20%, var(--bg));
		--node-stroke: color-mix(in oklch, var(--c) 55%, var(--bg));
		--node-sw: 1.2;
		--node-filter: drop-shadow(0 2px 5px color-mix(in oklch, var(--c) 28%, transparent));
		--label-weight: 650;
	}
	.look-glass {
		--edge-stroke: color-mix(in oklch, var(--muted) 85%, var(--accent));
		--edge-sw: 1.4;
	}
	.node .sheen {
		stroke: none;
		pointer-events: none;
	}
	.node .bar {
		stroke: var(--c);
		stroke-width: 2.5;
	}

	/* The "diagram" look: flat draw.io-style colours per kind, dark icons, black right-angled
	   edges. */
	.look-diagram {
		--edge-stroke: var(--text);
		--edge-sw: 1;
		--edge-opacity: 1;
		--dg-icon: #23262b;
		--dg-tile: #ffffff;
	}
	.look-diagram .node {
		--node-sw: 1;
		--icon-stroke: var(--dg-icon);
		--icon-sw: 1.6;
		--label-weight: 500;
		--node-fill: var(--dg-fill, #f5f5f5);
		--node-stroke: var(--dg-line, #666666);
	}
	.look-diagram .k-input {
		--dg-fill: #f8cecc;
		--dg-line: #b85450;
	}
	.look-diagram .k-linear,
	.look-diagram .k-attention,
	.look-diagram .k-embedding {
		--dg-fill: #dae8fc;
		--dg-line: #6c8ebf;
	}
	.look-diagram .k-other {
		--dg-fill: #ffe6cc;
		--dg-line: #d79b00;
	}
	.look-diagram .k-op {
		--dg-fill: #d5e8d4;
		--dg-line: #82b366;
	}
	.look-diagram .k-norm,
	.look-diagram .k-activation {
		--dg-fill: #e1d5e7;
		--dg-line: #9673a6;
	}
	.look-diagram .node .detail {
		fill: var(--text);
	}
	.node .icon-tile {
		fill: var(--dg-tile);
		stroke: none;
	}
	@media (prefers-color-scheme: dark) {
		.look-diagram {
			--dg-icon: #e8e6df;
			--dg-tile: #2b2a27;
		}
		.look-diagram .node {
			--node-fill: color-mix(in oklch, var(--dg-line, #666666) 26%, var(--bg));
			--node-stroke: var(--dg-line, #8a8a8a);
		}
	}
	.node .has-card {
		fill: var(--c);
	}
	.node text {
		text-anchor: middle;
		fill: var(--text);
	}
	.node .label {
		font-size: 12.5px;
		font-weight: var(--label-weight, 500);
	}
	.node .detail {
		font-size: 10.5px;
		fill: var(--muted);
	}
	.node .shape {
		font-family: var(--mono);
		font-size: 10px;
		fill: var(--muted);
	}
	.node:focus-visible rect,
	.node:focus-visible circle {
		stroke-width: 2.5;
	}

	/* Hover/focus highlighting (toggled by nnInteraction.ts). */
	.edge,
	.node {
		transition: opacity 120ms ease;
	}
	.focusing .edge:not(.hot),
	.focusing .node:not(.hot) {
		opacity: 0.2;
	}
	.focusing .edge.hot path {
		stroke: var(--text);
		stroke-opacity: 1;
		stroke-width: 1.8;
	}
</style>
