---
// One weight tensor in a node's hover card: its name (LaTeX), shape and parameter count, its
// moments, the histogram of its values and, for matrices and up, its rank and singular values.
import katex from "katex";
import SpectrumChart from "./SpectrumChart.astro";
import ValueHistogram from "./ValueHistogram.astro";
import { type WeightSummary, formatValue } from "./weightStats";

interface Props {
	summary: WeightSummary;
}

const { summary: ws } = Astro.props;
// Names are LaTeX, so "W^Q" or "b_1" typeset properly.
const name = katex.renderToString(ws.name, {
	throwOnError: false,
	output: "html",
});
const stats = [
	["mean", ws.mean],
	["std", ws.std],
	["min", ws.min],
	["max", ws.max],
] as const;
---

<section class="weights">
	<div class="head">
		<span class="name" set:html={name} />
		<code>{ws.shape.join("×")}</code>
		<span class="count">{ws.count.toLocaleString("en-US")} param{ws.count === 1 ? "" : "s"}</span>
	</div>
	<dl class="stats">
		{
			stats.map(([k, v]) => (
				<div>
					<dt>{k}</dt>
					<dd>{formatValue(v)}</dd>
				</div>
			))
		}
	</dl>
	<ValueHistogram summary={ws} />
	{ws.rank && <SpectrumChart summary={{ ...ws, rank: ws.rank }} />}
</section>

<style>
	.weights {
		margin-top: 0.6rem;
		padding-top: 0.5rem;
		border-top: 1px solid var(--faint);
	}
	.head {
		display: flex;
		align-items: baseline;
		gap: 0.45rem;
	}
	.name :global(.katex) {
		font-size: 1.05rem;
	}
	code,
	dd {
		font-family: var(--mono);
		font-size: 0.68rem;
		color: var(--muted);
		background: none;
		padding: 0;
	}
	.count {
		margin-left: auto;
		color: var(--muted);
	}
	.stats {
		display: grid;
		grid-template-columns: repeat(4, auto);
		justify-content: space-between;
		gap: 0.5rem;
		margin: 0.35rem 0 0;
	}
	dt {
		font-size: 0.62rem;
		color: var(--muted);
		text-transform: uppercase;
		letter-spacing: 0.04em;
	}
	dd {
		margin: 0;
		color: var(--text);
	}
</style>
