---
// A weight tensor's singular values, largest first, on a log scale. The caption gives the
// numerical rank; the chart marks the tolerance below which values count as zero, and the
// cut-off between the rank-th value and the next.
import MiniChart from "./MiniChart.astro";
import type { WeightSummary } from "./weightStats";

interface Props {
	summary: WeightSummary & { rank: NonNullable<WeightSummary["rank"]> };
	width?: number;
	height?: number;
}

const { summary, width = 240, height = 44 } = Astro.props;
const { rank } = summary;
const r1 = (v: number) => Math.round(v * 10) / 10;
const s = rank.singular;

// y runs from log10(σ/σ₁) = 0 at the top down to `floor` at the baseline, a little below the
// smallest value worth showing (the tolerance, or the smallest non-zero singular value).
const top = s[0] || 1;
const positive = s.filter((v) => v > 0);
const low = Math.max(rank.tol, positive[positive.length - 1] ?? top * 1e-12);
const floor = Math.min(-1, Math.log10(low / top) - 0.5);
const y = (v: number) =>
	r1((Math.max(Math.log10(Math.max(v, 1e-300) / top), floor) / floor) * height);
const x = (i: number) =>
	s.length > 1 ? r1((i / (s.length - 1)) * width) : width / 2;

// At most ~160 points, always keeping the two either side of the rank cut-off and the last.
const step = Math.max(1, Math.ceil(s.length / 160));
const keep = [...s.keys()].filter(
	(i) =>
		i % step === 0 ||
		i === s.length - 1 ||
		i === rank.rank - 1 ||
		i === rank.rank,
);
const d = keep.map((i, k) => `${k ? "L" : "M"}${x(i)},${y(s[i])}`).join(" ");
const tolY =
	rank.tol > 0 && Math.log10(rank.tol / top) > floor ? y(rank.tol) : undefined;
const cut =
	rank.rank < s.length ? r1((x(rank.rank - 1) + x(rank.rank)) / 2) : undefined;

const subscript = (k: number) =>
	[...String(k)].map((c) => "₀₁₂₃₄₅₆₇₈₉"[Number(c)]).join("");
const ticks = [
	{ x: 0, text: "σ₁" },
	{
		x: width / 2,
		text: "singular values, log scale",
		anchor: "middle" as const,
	},
	{ x: width, text: `σ${subscript(rank.full)}`, anchor: "end" as const },
];
---

<MiniChart width={width} height={height} ticks={ticks}>
	<Fragment slot="caption">
		Rank <strong>{rank.rank}</strong> of {rank.full}
		{rank.rank === rank.full ? " (full)" : ""}
		{summary.shape.length > 2 && <span> · of the {rank.rows}×{rank.cols} unfolding</span>}
	</Fragment>
	{tolY !== undefined && <line class="tol" x1="0" x2={width} y1={tolY} y2={tolY} />}
	{cut !== undefined && <line class="cut" x1={cut} x2={cut} y1="0" y2={height} />}
	<path class="line" d={d} />
</MiniChart>

<style>
	.line {
		fill: none;
		stroke: var(--chart, var(--c));
		stroke-width: 2;
		stroke-linejoin: round;
		stroke-linecap: round;
	}
	.tol {
		stroke: var(--faint);
		stroke-dasharray: 3 3;
	}
	.cut {
		stroke: var(--muted);
		stroke-dasharray: 2 2;
	}
</style>
