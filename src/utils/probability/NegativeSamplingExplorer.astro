---
// Interactive negative sampling (Algorithm 1 of Wang, Zhang and Wang, 2021) on simulated rare
// events data: x ~ N(0, 1), Pr(y = 1 | x) = sigmoid(alpha + x). All positives are kept; a negative
// at x is kept with probability pi(x), either uniform (rho) or proportional to the optimal
// phi_os(x) of Theorem 3 (computed from the true parameter, floored at rho / 10 and capped at 1).
// The top panel is a histogram of x (log scale) for all negatives, kept negatives and positives;
// the middle panel draws pi(x). The table fits three estimators to the subsample: unweighted
// (no correction), inverse probability weighted (IPW) and the log-odds-corrected likelihood.
// "Repeat" reruns the experiment and compares N1 x MSE with the asymptotic trace of V_w, V_lik.
// Usage in .mdx:
//   <NegativeSamplingExplorer alpha={-5} n={50000} rho={0.02} scheme="uniform" />
import type { Scheme } from "./negativeSampling";

interface Props {
	/** True intercept; beta is fixed at 1. */
	alpha?: number;
	/** Full data size. */
	n?: number;
	/** Initial sampling rate on negatives, one of the slider values. */
	rho?: number;
	scheme?: Scheme;
	/** Repetitions for the Repeat button. */
	repeats?: number;
}

const {
	alpha = -5,
	n = 50000,
	rho = 0.02,
	scheme = "uniform",
	repeats = 200,
} = Astro.props;
const rhos = [0.005, 0.01, 0.02, 0.05, 0.1, 0.2];
const rhoIndex = Math.max(0, rhos.indexOf(rho));
---

<figure class="ns-explorer" data-alpha={alpha} data-n={n} data-repeats={repeats} data-rhos={JSON.stringify(rhos)}>
	<div class="ns-controls">
		<label>
			Negative sampling
			<select class="ns-scheme">
				<option value="uniform" selected={scheme === "uniform"}>Uniform</option>
				<option value="optimal" selected={scheme === "optimal"}>Optimal (Theorem 3)</option>
			</select>
		</label>
		<label class="ns-rate">
			Sampling rate ρ = <span class="ns-rho-value"></span>
			<input class="ns-rho" type="range" min="0" max={rhos.length - 1} step="1" value={rhoIndex} />
		</label>
		<div class="ns-buttons">
			<button class="ns-new" type="button">New data</button>
			<button class="ns-repeat" type="button">Repeat {repeats}×</button>
		</div>
	</div>
	<svg viewBox="0 0 720 360" role="img" aria-label="Histogram of negatives, kept negatives and positives, and the sampling probability">
		<title>Histogram of negatives, kept negatives and positives, and the sampling probability</title>
		<g class="ns-hist-grid"></g>
		<g class="ns-hist"></g>
		<g class="ns-legend">
			<rect x="500" y="0" width="12" height="10" class="ns-all" /><text x="518" y="10">all negatives</text>
			<rect x="500" y="22" width="12" height="10" class="ns-kept" /><text x="518" y="32">kept negatives</text>
			<rect x="500" y="44" width="12" height="10" class="ns-pos" /><text x="518" y="54">positives (all kept)</text>
		</g>
		<text x="58" y="248" class="ns-panel-title">π(x): chance that a negative at x is kept</text>
		<g class="ns-pi-grid"></g>
		<path class="ns-pi" />
		<g class="ns-xticks"></g>
		<text x="380" y="356" text-anchor="middle" class="ns-axis-label">feature x</text>
	</svg>
	<div class="ns-metrics" aria-live="polite">
		<div><span>Positives N₁</span><strong class="ns-n1"></strong></div>
		<div><span>Kept negatives</span><strong class="ns-n0"></strong></div>
		<div><span>Positives per kept negative</span><strong class="ns-ratio"></strong></div>
	</div>
	<table class="ns-table">
		<thead>
			<tr><th>Estimator</th><th>α̂</th><th>β̂</th><th class="ns-rep-head">N₁ × MSE (sim / theory)</th></tr>
		</thead>
		<tbody>
			<tr><td>Truth</td><td class="ns-ta"></td><td>1.000</td><td></td></tr>
			<tr><td>Unweighted, no correction</td><td data-est="naive" data-k="0"></td><td data-est="naive" data-k="1"></td><td data-rep="naive"></td></tr>
			<tr><td>IPW, eq. (2)</td><td data-est="ipw" data-k="0"></td><td data-est="ipw" data-k="1"></td><td data-rep="ipw"></td></tr>
			<tr><td>Log odds corrected likelihood, eq. (5)</td><td data-est="lik" data-k="0"></td><td data-est="lik" data-k="1"></td><td data-rep="lik"></td></tr>
		</tbody>
	</table>
	<figcaption>
		<span class="ns-status">Press “Repeat” to rerun the experiment and compare with Theorems 2 and 4.</span>
	</figcaption>
</figure>

<script>
	import {
		type Dataset,
		effectivePhi,
		generate,
		mulberry32,
		negativeProb,
		type Scheme,
		type SampleResult,
		sampleAndFit,
		trace2,
		varianceIpw,
		varianceLik,
	} from "./negativeSampling";

	const NS = "http://www.w3.org/2000/svg";
	const X_MIN = -4;
	const X_MAX = 4;
	const BINS = 32;
	const LEFT = 58;
	const RIGHT = 700;
	const H_TOP = 66;
	const H_BOTTOM = 220;
	const LOG_MAX = 5;
	const P_TOP = 258;
	const P_BOTTOM = 330;

	const sx = (x: number) => LEFT + ((x - X_MIN) / (X_MAX - X_MIN)) * (RIGHT - LEFT);
	const sLog = (count: number) => H_BOTTOM - (Math.log10(Math.max(count, 1)) / LOG_MAX) * (H_BOTTOM - H_TOP);
	const sPi = (p: number) => P_BOTTOM - p * (P_BOTTOM - P_TOP);

	function el(name: string, attrs: Record<string, string | number>, text?: string) {
		const node = document.createElementNS(NS, name);
		for (const [k, v] of Object.entries(attrs)) node.setAttribute(k, String(v));
		if (text !== undefined) node.textContent = text;
		return node;
	}

	function attach(figure: HTMLElement) {
		const alpha = Number(figure.dataset.alpha);
		const n = Number(figure.dataset.n);
		const repeats = Number(figure.dataset.repeats);
		const rhos: number[] = JSON.parse(figure.dataset.rhos ?? "[]");
		const schemeSelect = figure.querySelector<HTMLSelectElement>(".ns-scheme")!;
		const rhoInput = figure.querySelector<HTMLInputElement>(".ns-rho")!;
		const status = figure.querySelector<HTMLElement>(".ns-status")!;
		const repeatButton = figure.querySelector<HTMLButtonElement>(".ns-repeat")!;
		let seed = 2021;
		let data: Dataset = generate(n, alpha, 1, mulberry32(seed));
		let runId = 0;

		figure.querySelector(".ns-ta")!.textContent = alpha.toFixed(3);

		// Static axes.
		const grid = figure.querySelector(".ns-hist-grid")!;
		for (let k = 0; k <= LOG_MAX; k++) {
			const y = sLog(10 ** k);
			grid.append(el("line", { x1: LEFT, x2: RIGHT, y1: y, y2: y, class: "ns-gridline" }));
			grid.append(el("text", { x: LEFT - 6, y: y + 4, "text-anchor": "end", class: "ns-tick" }, k < 2 ? String(10 ** k) : `10${"⁰¹²³⁴⁵⁶⁷⁸⁹"[k]}`));
		}
		grid.append(el("text", { x: 10, y: 30, class: "ns-tick" }, "count (log scale)"));
		const piGrid = figure.querySelector(".ns-pi-grid")!;
		for (const p of [0, 0.5, 1]) {
			const y = sPi(p);
			piGrid.append(el("line", { x1: LEFT, x2: RIGHT, y1: y, y2: y, class: "ns-gridline" }));
			piGrid.append(el("text", { x: LEFT - 6, y: y + 4, "text-anchor": "end", class: "ns-tick" }, String(p)));
		}
		const xticks = figure.querySelector(".ns-xticks")!;
		for (let x = X_MIN; x <= X_MAX; x++) {
			xticks.append(el("text", { x: sx(x), y: 344, "text-anchor": "middle", class: "ns-tick" }, String(x)));
		}

		const scheme = () => schemeSelect.value as Scheme;
		const rho = () => rhos[Number(rhoInput.value)];

		function clearRepeat() {
			for (const cell of figure.querySelectorAll<HTMLElement>("[data-rep]")) cell.textContent = "";
		}

		function draw(result: SampleResult) {
			const all = new Array(BINS).fill(0);
			const kept = new Array(BINS).fill(0);
			const pos = new Array(BINS).fill(0);
			const bin = (x: number) => Math.min(BINS - 1, Math.max(0, Math.floor(((x - X_MIN) / (X_MAX - X_MIN)) * BINS)));
			for (let i = 0; i < data.x.length; i++) {
				if (data.y[i] === 0) all[bin(data.x[i])]++;
				else pos[bin(data.x[i])]++;
			}
			for (const i of result.kept) if (data.y[i] === 0) kept[bin(data.x[i])]++;
			const hist = figure.querySelector(".ns-hist")!;
			hist.replaceChildren();
			const w = (RIGHT - LEFT) / BINS;
			for (let b = 0; b < BINS; b++) {
				const x0 = LEFT + b * w;
				const bar = (count: number, x: number, width: number, cls: string) => {
					if (count < 1) return;
					const y = sLog(count);
					hist.append(el("rect", { x, y, width, height: H_BOTTOM - y, class: cls }));
				};
				bar(all[b], x0 + 1, w / 2 - 1, "ns-all");
				bar(kept[b], x0 + 1, w / 2 - 1, "ns-kept");
				bar(pos[b], x0 + w / 2, w / 2 - 1, "ns-pos");
			}
			const pts = Array.from({ length: 161 }, (_, i) => X_MIN + (i / 160) * (X_MAX - X_MIN));
			const d = pts.map((x, i) => `${i ? "L" : "M"}${sx(x).toFixed(1)},${sPi(negativeProb(scheme(), x, rho())).toFixed(1)}`).join(" ");
			figure.querySelector(".ns-pi")!.setAttribute("d", d);

			figure.querySelector(".ns-n1")!.textContent = result.positives.toLocaleString();
			figure.querySelector(".ns-n0")!.textContent = result.keptNegatives.toLocaleString();
			figure.querySelector(".ns-ratio")!.textContent = (result.positives / result.keptNegatives).toFixed(2);
			for (const cell of figure.querySelectorAll<HTMLElement>("[data-est]")) {
				const est = result[cell.dataset.est as "naive" | "ipw" | "lik"];
				cell.textContent = est[Number(cell.dataset.k)].toFixed(3);
			}
		}

		function update(resample = true) {
			runId++;
			figure.querySelector(".ns-rho-value")!.textContent = String(rho());
			clearRepeat();
			status.textContent = `Press “Repeat” to rerun the experiment ${repeats} times and compare with Theorems 2 and 4.`;
			if (resample) draw(sampleAndFit(data, scheme(), rho(), mulberry32(seed * 7919 + Number(rhoInput.value))));
		}

		async function repeat() {
			const id = ++runId;
			const rng = mulberry32(seed + 104729);
			const sse = { naive: 0, ipw: 0, lik: 0 };
			let n1 = 0;
			repeatButton.disabled = true;
			for (let r = 0; r < repeats; r++) {
				if (r % 10 === 0) {
					status.textContent = `Running repetition ${r + 1} of ${repeats}…`;
					await new Promise((resolve) => setTimeout(resolve, 0));
					if (id !== runId) {
						repeatButton.disabled = false;
						return;
					}
				}
				const d = generate(n, alpha, 1, rng);
				const res = sampleAndFit(d, scheme(), rho(), rng);
				n1 += res.positives;
				for (const k of ["naive", "ipw", "lik"] as const) {
					sse[k] += (res[k][0] - alpha) ** 2 + (res[k][1] - 1) ** 2;
				}
			}
			repeatButton.disabled = false;
			n1 /= repeats;
			const c = Math.exp(alpha) / rho();
			const phi = effectivePhi(scheme(), rho());
			const theory = { naive: Number.NaN, ipw: trace2(varianceIpw(phi, c)), lik: trace2(varianceLik(phi, c)) };
			for (const k of ["naive", "ipw", "lik"] as const) {
				const sim = (n1 * sse[k]) / repeats;
				const cell = figure.querySelector<HTMLElement>(`[data-rep="${k}"]`)!;
				cell.textContent = Number.isNaN(theory[k]) ? `${sim.toFixed(1)} / biased` : `${sim.toFixed(2)} / ${theory[k].toFixed(2)}`;
			}
			status.textContent = `${repeats} fresh datasets of ${n.toLocaleString()} points. MSE adds the squared errors of α̂ and β̂; theory is tr(V) from Theorems 2 and 4 with c = e^α/ρ = ${c.toFixed(3)}. The full-data value is 3.`;
		}

		schemeSelect.addEventListener("change", () => update());
		rhoInput.addEventListener("input", () => update());
		figure.querySelector(".ns-new")!.addEventListener("click", () => {
			seed++;
			data = generate(n, alpha, 1, mulberry32(seed));
			update();
		});
		repeatButton.addEventListener("click", repeat);
		update();
	}

	document.querySelectorAll<HTMLElement>(".ns-explorer").forEach(attach);
</script>

<style>
	.ns-explorer {
		--ns-pos: #b4532a;
		margin: 2rem 0;
	}
	@media (prefers-color-scheme: dark) {
		.ns-explorer { --ns-pos: #e8a07a; }
	}
	.ns-controls { display: flex; flex-wrap: wrap; align-items: end; gap: .8rem 1.2rem; margin-bottom: .4rem; color: var(--muted); font-size: .9rem; }
	.ns-controls select { display: block; margin-top: .2rem; padding: .25rem .4rem; color: var(--text); background: var(--surface); border: 1px solid var(--faint); border-radius: 4px; }
	.ns-rate { flex: 1; min-width: 12rem; }
	.ns-rate input { display: block; width: 100%; accent-color: var(--accent); }
	.ns-buttons { display: flex; gap: .5rem; }
	.ns-buttons button { border: 1px solid var(--faint); border-radius: 4px; padding: .35rem .7rem; color: var(--text); background: var(--surface); cursor: pointer; }
	.ns-buttons button:disabled { opacity: .5; cursor: progress; }
	svg { display: block; width: 100%; height: auto; font: 12px var(--sans); }
	/* Grid lines, ticks and bars are created by the script, so they lack the scoped attribute. */
	.ns-explorer :global(.ns-gridline) { stroke: var(--faint); stroke-width: 1; }
	.ns-explorer :global(.ns-tick), .ns-legend text, .ns-axis-label { fill: var(--muted); }
	.ns-panel-title { fill: var(--text); font-weight: 600; }
	.ns-explorer :global(.ns-all) { fill: color-mix(in srgb, var(--muted) 40%, transparent); }
	.ns-explorer :global(.ns-kept) { fill: var(--accent); }
	.ns-explorer :global(.ns-pos) { fill: var(--ns-pos); }
	.ns-pi { fill: none; stroke: var(--accent); stroke-width: 2.5; }
	.ns-metrics { display: grid; grid-template-columns: repeat(3, 1fr); gap: .6rem; margin-top: .25rem; }
	.ns-metrics div { padding: .55rem .75rem; border: 1px solid var(--faint); border-radius: 5px; background: var(--surface); }
	.ns-metrics span, .ns-metrics strong { display: block; }
	.ns-metrics span { color: var(--muted); font-size: .78rem; }
	.ns-metrics strong { margin-top: .15rem; color: var(--text); font-size: 1.05rem; }
	.ns-table { width: 100%; margin-top: .8rem; border-collapse: collapse; font: .85rem var(--sans); }
	.ns-table th, .ns-table td { padding: .3rem .5rem; border-bottom: 1px solid var(--faint); text-align: right; font-variant-numeric: tabular-nums; }
	.ns-table th:first-child, .ns-table td:first-child { text-align: left; }
	.ns-table th { color: var(--muted); font-weight: 600; }
	figcaption { margin-top: .65rem; color: var(--muted); font-size: .9rem; }
	@media (max-width: 560px) {
		svg { font-size: 19px; }
		.ns-metrics { grid-template-columns: 1fr; }
		.ns-rep-head { font-size: .75rem; }
	}
</style>
