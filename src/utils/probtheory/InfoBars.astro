---
// Entropies and mutual information of two binary variables (Bishop & Bishop, Sections
// 2.5.6–2.5.7 and Exercise 2.36), drawn as an information diagram: the top bar is the joint
// entropy H[x, y]; below it H[x] (blue) and H[y] (purple) are laid out so that their overlap
// (gold) is the mutual information I[x, y], the part of H[x] outside the overlap is H[x | y]
// and the part of H[y] outside it is H[y | x]. This is the Venn diagram of the exercise with
// lengths that are exact. Edit the 2 × 2 joint table (entries are renormalised) or pick a
// preset. Logic in probTheory.ts.
// Usage in .mdx:
//   <InfoBars preset="ex236" />
import "../sampling/sampling.css";
import "./probTheory.css";

interface Props {
	preset?: "ex236" | "independent" | "copy" | "noisy";
	title?: string;
	caption?: string;
}

const { preset = "ex236", title, caption } = Astro.props;
---

<figure class="smp-fig pt-info" data-preset={preset}>
	{title && <div class="smp-title">{title}</div>}
	<div class="pt-table-wrap">
		<table class="pt-joint">
			<tr><th>p(x, y)</th><th>y = 0</th><th>y = 1</th></tr>
			<tr><th>x = 0</th><td><input class="c00" type="number" min="0" step="0.05" aria-label="p(x=0, y=0)" /></td><td><input class="c01" type="number" min="0" step="0.05" aria-label="p(x=0, y=1)" /></td></tr>
			<tr><th>x = 1</th><td><input class="c10" type="number" min="0" step="0.05" aria-label="p(x=1, y=0)" /></td><td><input class="c11" type="number" min="0" step="0.05" aria-label="p(x=1, y=1)" /></td></tr>
		</table>
		<div class="smp-controls" style="margin-top: 0">
			<label>preset
				<select class="i-preset" aria-label="Preset joint distribution">
					<option value="ex236">Exercise 2.36 (1/3, 1/3, 0, 1/3)</option>
					<option value="independent">independent</option>
					<option value="copy">y = x</option>
					<option value="noisy">y = x flipped 10% of the time</option>
				</select>
			</label>
		</div>
	</div>
	<svg class="smp-svg" viewBox="0 0 640 150" role="img" aria-label="Information diagram of joint, marginal and conditional entropies"></svg>
	<table class="smp-table pt-info-table"></table>
	{caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
	import { info } from "./probTheory";
	import { el, fmt } from "../sampling/plot";

	const presets: Record<string, number[]> = {
		ex236: [1 / 3, 1 / 3, 0, 1 / 3],
		independent: [0.3 * 0.6, 0.3 * 0.4, 0.7 * 0.6, 0.7 * 0.4],
		copy: [0.5, 0, 0, 0.5],
		noisy: [0.45, 0.05, 0.05, 0.45],
	};

	function attach(fig: HTMLElement) {
		const svg = fig.querySelector("svg")!;
		const cells = ["c00", "c01", "c10", "c11"].map((c) => fig.querySelector<HTMLInputElement>(`.${c}`)!);
		const sel = fig.querySelector<HTMLSelectElement>(".i-preset")!;
		const table = fig.querySelector(".pt-info-table")!;
		const fill = (v: number[]) => cells.forEach((c, i) => (c.value = fmt(v[i], 4)));
		sel.value = fig.dataset.preset ?? "ex236";
		fill(presets[sel.value]);

		function draw() {
			const raw = cells.map((c) => Math.max(0, Number(c.value) || 0));
			const tot = raw.reduce((a, b) => a + b, 0) || 1;
			const v = raw.map((x) => x / tot);
			const q = info([
				[v[0], v[1]],
				[v[2], v[3]],
			]);
			const scale = 560 / Math.log(4);
			const x0 = 40;
			svg.replaceChildren();
			const bar = (x: number, w: number, y: number, cls: string, label: string) => {
				el("rect", { x, y, width: Math.max(0, w), height: 26, class: cls }, svg);
				if (w > 40) el("text", { x: x + w / 2, y: y + 17, class: "smp-text", "text-anchor": "middle" }, svg, label);
			};
			bar(x0, q.hxy * scale, 8, "pt-info-joint", `H[x,y] = ${fmt(q.hxy, 3)}`);
			bar(x0, q.hx * scale, 48, "pt-info-hx", "");
			bar(x0 + q.hxGivenY * scale, q.hy * scale, 88, "pt-info-hy", "");
			el("rect", { x: x0 + q.hxGivenY * scale, y: 48, width: Math.max(0, q.mi * scale), height: 66, class: "pt-info-mi" }, svg);
			const lab = (x: number, w: number, y: number, t: string) => w > 30 && el("text", { x: x + w / 2, y, class: "smp-text", "text-anchor": "middle" }, svg, t);
			lab(x0, q.hxGivenY * scale, 65, `H[x|y] ${fmt(q.hxGivenY, 3)}`);
			lab(x0 + q.hxGivenY * scale, q.mi * scale, 85, `I ${fmt(q.mi, 3)}`);
			lab(x0 + q.hx * scale, q.hyGivenX * scale, 105, `H[y|x] ${fmt(q.hyGivenX, 3)}`);
			el("text", { x: x0 - 6, y: 66, class: "smp-note", "text-anchor": "end" }, svg, "H[x]");
			el("text", { x: x0 - 6, y: 106, class: "smp-note", "text-anchor": "end" }, svg, "H[y]");
			el("line", { x1: x0 + Math.log(4) * scale, x2: x0 + Math.log(4) * scale, y1: 4, y2: 120, class: "smp-muted-line" }, svg);
			el("text", { x: x0 + Math.log(4) * scale, y: 138, class: "smp-note", "text-anchor": "end" }, svg, "ln 4 (maximum for two bits)");
			el("text", { x: x0, y: 138, class: "smp-note" }, svg, "0 nats");
			const row = (n: string, val: number) => `<tr><td>${n}</td><td>${fmt(val, 4)}</td><td>${fmt(val / Math.LN2, 4)}</td></tr>`;
			table.innerHTML =
				`<tr><th>quantity</th><th>nats</th><th>bits</th></tr>` +
				row("H[x]", q.hx) +
				row("H[y]", q.hy) +
				row("H[y | x]", q.hyGivenX) +
				row("H[x | y]", q.hxGivenY) +
				row("H[x, y]", q.hxy) +
				row("I[x, y]", q.mi);
		}
		for (const c of cells)
			c.addEventListener("input", () => {
				sel.value = "";
				draw();
			});
		sel.addEventListener("change", () => {
			if (presets[sel.value]) fill(presets[sel.value]);
			draw();
		});
		draw();
	}

	document.querySelectorAll<HTMLElement>(".pt-info").forEach(attach);
</script>
