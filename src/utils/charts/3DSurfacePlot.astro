		color: var(--muted);
	}
	.range-slider {
		display: grid;
		grid-template-columns: 2.5rem 4rem 1fr 4rem;
		align-items: center;
		gap: 0.6rem;
	}
	.slider-label {
		color: var(--text);
	}
	.slider-value {
		font-family: var(--mono);
		font-size: 0.75rem;
	}
	.slider-value.lo {
		text-align: right;
	}
	.range-sliders button {
		align-self: flex-end;
		padding: 0.25rem 0.7rem;
		font: inherit;
		color: var(--text);
		background: var(--surface);
		border: 1px solid var(--faint);
		border-radius: 6px;
		cursor: pointer;
	}
	.range-sliders button:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 1px;
	}
	.track {
		position: relative;
		height: 0.9rem;
		border-radius: 999px;
		background: var(--surface);
		border: 1px solid var(--faint);
		cursor: pointer;
		touch-action: none;
	}
	.window {
		position: absolute;
		top: -1px;
		bottom: -1px;
		border-radius: 999px;
		background: color-mix(in oklch, var(--accent) 20%, transparent);
		border: 1px solid color-mix(in oklch, var(--accent) 55%, transparent);
