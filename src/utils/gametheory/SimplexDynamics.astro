---
// Dynamics of mixed strategies in generalised Rock–Paper–Scissors (a win pays `win`, a loss costs
// `lose`), drawn on the simplex of mixtures (x_R, x_P, x_S); the centre (⅓, ⅓, ⅓) is the Nash
// equilibrium. Three modes:
//   replicator: grey arrows show the replicator field dx_i/dt = x_i((Ax)_i − xᵀAx); the blue
//     path is a trajectory from the start point (click the triangle to restart from there). It
//     orbits forever when win = lose, spirals in when win > lose and out when win < lose.
//   fictitious: the empirical frequency of play when one population best-responds to the history
//     so far (symmetric fictitious play), starting from one Rock.
//   hedge: two players run Hedge (multiplicative weights, η = 0.1) against each other in standard
//     RPS; blue is Row's current mixture, orange its time average. The current mixture spirals out
//     to the corners while the average converges to the equilibrium.
// Play animates the path. Logic in gameTheory.ts.
// Usage in .mdx:
//   <SimplexDynamics mode="replicator" win={1} lose={1} />
//   <SimplexDynamics mode="hedge" />
import Player from "../sampling/Player.astro";
import "../sampling/sampling.css";
import "./gametheory.css";

interface Props {
	mode?: "replicator" | "fictitious" | "hedge";
	win?: number;
	lose?: number;
	title?: string;
	caption?: string;
}

const { mode = "replicator", win = 1, lose = 1, title, caption } = Astro.props;
---

<figure class="smp-fig gt-simplex-fig" data-mode={mode}>
	{title && <div class="smp-title">{title}</div>}
	<div class="smp-legend">
		<span class="lg-field"><i class="gt-k-muted"></i>replicator field</span>
		<span><i class="gt-k-row"></i><span class="lg-path">trajectory</span></span>
		<span class="lg-avg"><i class="gt-k-col"></i>time average</span>
		<span><i class="dot gt-k-ne"></i>Nash equilibrium (⅓, ⅓, ⅓)</span>
	</div>
	<svg class="smp-svg gt-simplex" viewBox="0 0 640 340" role="img" aria-label="Dynamics on the simplex of Rock-Paper-Scissors mixtures"></svg>
	<div class="smp-controls">
		<Player />
		<label>dynamics
			<select class="i-mode">
				<option value="replicator" selected={mode === "replicator"}>replicator</option>
				<option value="fictitious" selected={mode === "fictitious"}>fictitious play</option>
				<option value="hedge" selected={mode === "hedge"}>Hedge self-play</option>
			</select>
		</label>
		<label class="smp-slider c-rps">win <input type="range" class="i-win" min="0.5" max="2" step="0.1" value={win} /><strong class="o-win"></strong></label>
		<label class="smp-slider c-rps">lose <input type="range" class="i-lose" min="0.5" max="2" step="0.1" value={lose} /><strong class="o-lose"></strong></label>
	</div>
	<p class="smp-narration"></p>
	{caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
	import { fictitiousPlay, hedgeSelfPlay, replicatorField, replicatorPath, rpsMatrix } from "./gameTheory";
	import { bindPlayer, el, fmt } from "../sampling/plot";

	const V = [
		[320, 22],
		[110, 318],
		[530, 318],
	];
	const toXY = (x: number[]) => [
		x[0] * V[0][0] + x[1] * V[1][0] + x[2] * V[2][0],
		x[0] * V[0][1] + x[1] * V[1][1] + x[2] * V[2][1],
	];
	// Barycentric coordinates of a point in the triangle.
	function toBary(px: number, py: number): number[] | null {
		const [[x1, y1], [x2, y2], [x3, y3]] = V;
		const det = (y2 - y3) * (x1 - x3) + (x3 - x2) * (y1 - y3);
		const a = ((y2 - y3) * (px - x3) + (x3 - x2) * (py - y3)) / det;
		const b = ((y3 - y1) * (px - x3) + (x1 - x3) * (py - y3)) / det;
		const c = 1 - a - b;
		return a > 0.005 && b > 0.005 && c > 0.005 ? [a, b, c] : null;
	}
	const pathD = (pts: number[][]) =>
		pts.map((x, i) => {
			const [px, py] = toXY(x);
			return `${i ? "L" : "M"}${px.toFixed(1)},${py.toFixed(1)}`;
		}).join("");

	function attach(fig: HTMLElement) {
		const svg = fig.querySelector("svg")!;
		const $ = <T extends Element>(s: string) => fig.querySelector<T>(s)!;
		const im = $<HTMLSelectElement>(".i-mode");
		const iw = $<HTMLInputElement>(".i-win");
		const il = $<HTMLInputElement>(".i-lose");
		const say = $(".smp-narration");
		let start = [0.6, 0.3, 0.1];
		let main: number[][] = [];
		let avg: number[][] = [];
		let k = 0;

		function compute() {
			const mode = im.value;
			const A = rpsMatrix(Number(iw.value), Number(il.value));
			if (mode === "replicator") {
				main = replicatorPath(A, start, 3000, 0.01);
				avg = [];
			} else if (mode === "fictitious") {
				main = fictitiousPlay(A, [1, 0, 0], 1000);
				avg = [];
			} else {
				const h = hedgeSelfPlay(rpsMatrix(1, 1), [0.5, 0.3, 0.2], [0.2, 0.3, 0.5], 0.1, 2000);
				main = h.last;
				avg = h.avg;
			}
			k = main.length - 1;
			for (const c of fig.querySelectorAll<HTMLElement>(".c-rps")) c.style.display = mode === "hedge" ? "none" : "";
			$<HTMLElement>(".lg-field").style.display = mode === "replicator" ? "" : "none";
			$<HTMLElement>(".lg-avg").style.display = mode === "hedge" ? "" : "none";
			$(".lg-path").textContent = mode === "replicator" ? "trajectory" : mode === "fictitious" ? "empirical frequency" : "Row's current mixture";
		}

		function draw() {
			const mode = im.value;
			const win = Number(iw.value);
			const lose = Number(il.value);
			$(".o-win").textContent = fmt(win, 1);
			$(".o-lose").textContent = fmt(lose, 1);
			svg.replaceChildren();
			el("path", { d: `M${V[0]}L${V[1]}L${V[2]}Z`, class: "gt-tri" }, svg);
			["Rock", "Paper", "Scissors"].forEach((n, i) => {
				el("text", { x: V[i][0] + (i === 0 ? 0 : i === 1 ? -8 : 8), y: V[i][1] + (i === 0 ? -6 : 14), class: "smp-text", "text-anchor": i === 0 ? "middle" : i === 1 ? "end" : "start" }, svg, n);
			});
			if (mode === "replicator") {
				const A = rpsMatrix(win, lose);
				const N = 12;
				for (let a = 1; a < N; a++)
					for (let b = 1; a + b < N; b++) {
						const x = [a / N, b / N, (N - a - b) / N];
						const f = replicatorField(A, x);
						const [px, py] = toXY(x);
						const [qx, qy] = toXY(x.map((v, i) => v + f[i]));
						const dx = qx - px;
						const dy = qy - py;
						const len = Math.hypot(dx, dy);
						if (len < 1e-6) continue;
						const L = 6 + Math.min(10, len * 0.25);
						const ux = dx / len;
						const uy = dy / len;
						el("path", { d: `M${px},${py}l${ux * L},${uy * L}`, class: "gt-field" }, svg);
						el("path", { d: `M${px + ux * L},${py + uy * L}l${-4 * ux - 2 * uy},${-4 * uy + 2 * ux}l${4 * uy},${-4 * ux}z`, class: "gt-field-head" }, svg);
					}
			}
			el("path", { d: pathD(main.slice(0, k + 1)), class: "gt-path" }, svg);
			if (avg.length) el("path", { d: pathD(avg.slice(0, k + 1)), class: "gt-path-avg" }, svg);
			const [cx, cy] = toXY([1 / 3, 1 / 3, 1 / 3]);
			el("circle", { cx, cy, r: 5, class: "gt-ne-dot" }, svg);
			const cur = main[k];
			const [px, py] = toXY(cur);
			el("circle", { cx: px, cy: py, r: 4.5, class: "gt-cur" }, svg);
			if (avg.length) {
				const [ax, ay] = toXY(avg[k]);
				el("circle", { cx: ax, cy: ay, r: 4, class: "gt-ne-dot", style: "fill: var(--gt-col)" }, svg);
			}
			const show = (x: number[]) => `(${x.map((v) => fmt(v, 3)).join(", ")})`;
			if (mode === "replicator") {
				const prod = (x: number[]) => x[0] * x[1] * x[2];
				say.textContent = `t = ${fmt(k * 0.01, 1)}: x = ${show(cur)}. x_R x_P x_S = ${fmt(prod(cur), 4)} (started at ${fmt(prod(main[0]), 4)}); ${win === lose ? "it stays constant, so the path is a closed orbit" : win > lose ? "it rises towards 1/27 ≈ 0.0370 as the path spirals into the equilibrium" : "it falls towards 0 as the path spirals out to the edges"}. Click inside the triangle to start elsewhere.`;
			} else if (mode === "fictitious") {
				say.textContent = `After ${k} rounds the empirical frequency is ${show(cur)}. Each round the population plays a best response to this frequency, which pushes it round the triangle in ever smaller loops towards (⅓, ⅓, ⅓).`;
			} else {
				say.textContent = `Round ${k + 1}: Row's current mixture ${show(cur)}, its average so far ${show(avg[k])}. The current mixture cycles further and further out; the average closes in on the equilibrium.`;
			}
		}

		svg.addEventListener("click", (e) => {
			if (im.value !== "replicator") return;
			const r = svg.getBoundingClientRect();
			const b = toBary(((e.clientX - r.left) / r.width) * 640, ((e.clientY - r.top) / r.height) * 340);
			if (!b) return;
			start = b;
			compute();
			draw();
		});
		for (const i of [im, iw, il])
			i.addEventListener("input", () => {
				compute();
				draw();
			});
		bindPlayer(fig, (dir) => {
			const stride = Math.max(1, Math.round(main.length / 150));
			if (k >= main.length - 1 && dir === 1) k = 0;
			k = Math.max(0, Math.min(main.length - 1, k + dir * stride));
			draw();
			return k < main.length - 1;
		}, () => {
			k = 0;
			draw();
		}, 60);
		compute();
		draw();
	}

	document.querySelectorAll<HTMLElement>(".gt-simplex-fig").forEach(attach);
</script>
