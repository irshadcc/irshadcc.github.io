---
// Kelly betting. A bet wins b per unit staked with probability p and loses the stake
// otherwise; the bettor stakes a fixed fraction f of current wealth every round. Top: the
// expected log growth per bet g(f) = p ln(1 + f b) + (1 − p) ln(1 − f), with the Kelly fraction
// f* = p − (1 − p)/b at its peak and the chosen f marked. Bottom: wealth (log scale) over the
// same seeded sequence of wins and losses for half Kelly, Kelly, double Kelly and the chosen f.
// Readouts give the median growth e^{n g(f)} beside the mean (1 + f(pb − q))^n, which keeps
// rising with f even after the typical outcome has turned into ruin. Logic in quant.ts.
// Usage in .mdx:
//   <KellyExplorer p={0.6} b={1} bets={300} />
import "../sampling/sampling.css";
import "./quant.css";

interface Props {
	p?: number;
	b?: number;
	/** Bets per simulated path. */
	bets?: number;
	/** Initial fraction for the slider (default: Kelly). */
	f?: number;
	seed?: number;
	title?: string;
	caption?: string;
}

const { p = 0.6, b = 1, bets = 300, f, seed = 7, title, caption } = Astro.props;
const fStart = f ?? Math.max(0, p - (1 - p) / b);
---

<figure class="smp-fig qt-fig qt-kelly" data-b={b} data-bets={bets} data-seed={seed}>
	{title && <div class="smp-title">{title}</div>}
	<div class="smp-legend qt-legend">
		<span><i class="k-p"></i>growth rate g(f)</span>
		<span><i class="qt-k1"></i>½ Kelly</span>
		<span><i class="qt-k2"></i>Kelly f*</span>
		<span><i class="qt-k3"></i>2 × Kelly</span>
		<span><i class="qt-k4"></i>your f</span>
	</div>
	<svg class="smp-svg s-g" viewBox="0 0 640 190" role="img" aria-label="Expected log growth per bet against the fraction staked"></svg>
	<svg class="smp-svg s-w" viewBox="0 0 640 210" role="img" aria-label="Wealth paths for several betting fractions"></svg>
	<div class="smp-controls">
		<label class="smp-slider">win prob p = <strong class="v-p"></strong>
			<input type="range" class="i-p" min="0.5" max="0.75" step="0.01" value={p} aria-label="Win probability" />
		</label>
		<label class="smp-slider">your f = <strong class="v-f"></strong>
			<input type="range" class="i-f" min="0" max="0.95" step="0.01" value={fStart.toFixed(2)} aria-label="Fraction of wealth staked" />
		</label>
		<button type="button" class="smp-btn i-new">New outcomes</button>
	</div>
	<div class="smp-metrics">
		<div><span>Kelly f* = p − q/b</span><strong class="m-fs"></strong></div>
		<div><span>g(f) per bet</span><strong class="m-g"></strong></div>
		<div><span>median wealth e^(n·g)</span><strong class="m-med"></strong></div>
		<div><span>mean wealth (1 + f·edge)^n</span><strong class="m-mean"></strong></div>
		<div><span>this path, your f</span><strong class="m-path"></strong></div>
	</div>
	<p class="smp-narration"></p>
	{caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
	import { axes, curve, el, fmt } from "../sampling/plot";
	import { kellyFraction, kellyGrowth, mulberry32, wealthPath } from "./quant";

	const big = (v: number) => (v >= 1e6 || v < 1e-3 ? v.toExponential(1) : v >= 100 ? v.toFixed(0) : v.toFixed(3));

	function attach(fig: HTMLElement) {
		const b = Number(fig.dataset.b);
		const n = Number(fig.dataset.bets);
		let seed = Number(fig.dataset.seed);
		const sg = fig.querySelector<SVGSVGElement>(".s-g")!;
		const sw = fig.querySelector<SVGSVGElement>(".s-w")!;
		const pIn = fig.querySelector<HTMLInputElement>(".i-p")!;
		const fIn = fig.querySelector<HTMLInputElement>(".i-f")!;

		function draw() {
			const p = Number(pIn.value);
			const f = Number(fIn.value);
			const fs = kellyFraction(p, b);
			const gs = kellyGrowth(fs, p, b);
			const top = Math.max(gs * 1.3, 0.005);
			sg.replaceChildren();
			const G = axes(sg, { x: 52, y: 8, w: 572, h: 148 }, [0, 1], [-1.6 * top, top], { xLabel: "fraction staked f", yLabel: "g(f)", yTicks: 4 });
			el("line", { x1: G.box.x, x2: G.box.x + G.box.w, y1: G.sy(0), y2: G.sy(0), class: "smp-muted-line" }, sg);
			el("path", { d: curve(G, (x) => kellyGrowth(x, p, b), 400, 0, 0.995), class: "smp-p" }, sg);
			const mark = (x: number, cls: string, label: string) => {
				const y = kellyGrowth(x, p, b);
				el("line", { x1: G.sx(x), x2: G.sx(x), y1: G.box.y, y2: G.box.y + G.box.h, class: cls }, sg);
				if (Number.isFinite(y) && y > G.y[0]) el("circle", { cx: G.sx(x), cy: G.sy(y), r: 3.5, class: "smp-dot" }, sg);
				el("text", { x: G.sx(x) + 4, y: G.box.y + 12, class: "smp-note" }, sg, label);
			};
			if (fs > 0) mark(fs, "qt-l2", "f*");
			mark(f, "qt-l4", "f");

			const rng = mulberry32(seed);
			const outcomes = Array.from({ length: n }, () => rng() < p);
			const lines = [
				{ f: fs / 2, cls: "qt-l1" },
				{ f: fs, cls: "qt-l2" },
				{ f: Math.min(2 * fs, 0.99), cls: "qt-l3" },
				{ f, cls: "qt-l4" },
			].map((s) => ({ ...s, w: wealthPath(outcomes, s.f, b).map((v) => Math.log10(Math.max(v, 1e-12))) }));
			const all = lines.flatMap((l) => l.w);
			const lo = Math.max(-6, Math.floor(Math.min(...all)));
			const hi = Math.max(1, Math.ceil(Math.max(...all)));
			sw.replaceChildren();
			const W = axes(sw, { x: 52, y: 8, w: 572, h: 166 }, [0, n], [lo, hi], { xLabel: "bet number", yLabel: "log₁₀ wealth", yTicks: 5 });
			el("line", { x1: W.box.x, x2: W.box.x + W.box.w, y1: W.sy(0), y2: W.sy(0), class: "smp-muted-line" }, sw);
			for (const l of lines) {
				const d = l.w.map((y, i) => `${i ? "L" : "M"}${W.sx(i).toFixed(1)},${W.sy(Math.max(y, lo)).toFixed(1)}`).join("");
				el("path", { d, class: l.cls }, sw);
			}

			const g = kellyGrowth(f, p, b);
			const edge = p * b - (1 - p);
			fig.querySelector(".v-p")!.textContent = fmt(p, 2);
			fig.querySelector(".v-f")!.textContent = fmt(f, 2);
			fig.querySelector(".m-fs")!.textContent = fmt(fs, 3);
			fig.querySelector(".m-g")!.textContent = Number.isFinite(g) ? g.toFixed(4) : "−∞";
			fig.querySelector(".m-med")!.textContent = Number.isFinite(g) ? big(Math.exp(n * g)) : "0";
			fig.querySelector(".m-mean")!.textContent = big((1 + f * edge) ** n);
			fig.querySelector(".m-path")!.textContent = big(10 ** lines[3].w[n]);
			const wins = outcomes.filter(Boolean).length;
			fig.querySelector(".smp-narration")!.textContent =
				`This path has ${wins} wins in ${n} bets. ` +
				(Math.abs(f - fs) < 0.006
					? `f is the Kelly fraction: no other fixed fraction grows wealth faster in the long run (g = ${gs.toFixed(4)} per bet).`
					: f > fs && g < 0
					? `At f = ${fmt(f, 2)} the growth rate is negative: the mean still grows, but the typical (median) bettor goes broke.`
					: f > fs
						? `Betting more than f* = ${fmt(fs, 2)} adds risk and lowers growth: g(${fmt(f, 2)}) = ${g.toFixed(4)} < g(f*) = ${gs.toFixed(4)}.`
						: `Betting less than f* gives up some growth (g = ${g.toFixed(4)} vs ${gs.toFixed(4)}) for a much smoother path.`);
		}

		pIn.addEventListener("input", draw);
		fIn.addEventListener("input", draw);
		fig.querySelector(".i-new")!.addEventListener("click", () => {
			seed += 1;
			draw();
		});
		draw();
	}

	for (const fig of document.querySelectorAll<HTMLElement>(".qt-kelly")) attach(fig);
</script>
